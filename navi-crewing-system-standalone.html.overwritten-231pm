      id:null, current:true, vessel:r.vessel, vesselType:vm.vesselType||"", position:r.position,
      embarkDate:r.embarkDate, disembarkDate:r.actualDisembarkDate||"",
      grt:vm.grt||"", engineKW:vm.engineKW||"", reason: r.actualDisembarkDate ? (r.remarks||"") : ""
    };
  })() : null;
  const past = (r.serviceHistory||[]).map(h=>({...h, current:false}));
  const all = currentEntry ? [currentEntry, ...past] : past;
