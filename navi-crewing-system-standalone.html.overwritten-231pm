function computeMetrics(){
  const onboard = crew.filter(c=>c.status==="Onboard");
  const vacant = crew.filter(c=>c.status==="Vacant");
  const pooling = crew.filter(c=>c.status==="Standby/Pooling" || (c.relieverStatus && c.relieverStatus!=="For Deployment" && c.relieverStatus!=="Ext. Letter Received"));
  const nfr = crew.filter(c=>c.nfr || c.status==="Not for Rehire (NFR)");
  const illness = crew.filter(c=>c.illness);
  const incidents = crew.reduce((s,c)=>s+(Number(c.incidentCount)||0),0);
  const accidents = crew.reduce((s,c)=>s+(Number(c.accidentCount)||0),0);
  const buckets={overdue:0,m1:0,m2:0,m3:0,beyond:0};
  onboard.forEach(c=>{ const b=contractBucket(c); if(b) buckets[b]++; });
  const officersPooling = pooling.filter(c=>classify(c.position)==="Officer").length;
  const ratingsPooling = pooling.length-officersPooling;
  const officersNfr = nfr.filter(c=>classify(c.position)==="Officer").length;
  const ratingsNfr = nfr.length-officersNfr;
  const completed = log.filter(l=>l.actualDate && l.plannedDate);
  const onTime = completed.filter(l=>{ const p=parseDate(l.plannedDate), a=parseDate(l.actualDate); return p&&a&&a.getTime()<=p.getTime(); }).length;
  const delayed = completed.length-onTime;
  const onTimePct = completed.length? Math.round(onTime/completed.length*100): null;
  const delayedPct = completed.length? 100-onTimePct: null;
  return {total:crew.length,onboardCount:onboard.length,vacantCount:vacant.length,poolingCount:pooling.length,
    officersPooling,ratingsPooling,officersNfr,ratingsNfr,nfrCount:nfr.length,illnessCount:illness.length,
    incidents,accidents,buckets,completedChanges:completed.length,onTime,delayed,onTimePct,delayedPct};
}
function docStats(){
  let overdue=0,critical=0,soon=0,stable=0;
  docs.forEach(d=>{ const l=urgencyOf(d).level; if(l==="overdue")overdue++; else if(l==="critical")critical++; else if(l==="soon")soon++; else if(l==="stable")stable++; });
  return {overdue,critical,soon,stable,total:docs.length};
}
function segGauge(segments){
  const total = segments.reduce((s,x)=>s+x.value,0);
  const bar = total===0 ? `<div style="flex:1"></div>` : segments.map(s=>s.value>0?`<div style="width:${s.value/total*100}%;background:${s.color}" title="${s.label}: ${s.value}"></div>`:"").join("");
  const legend = segments.map(s=>`<div style="display:flex;align-items:center;gap:6px"><span class="dot" style="background:${s.color}"></span><span style="color:${SLATE}">${s.label}:</span><strong style="color:${NAVY}">${s.value}</strong></div>`).join("");
  return `<div class="gauge-bar">${bar}</div><div class="gauge-legend">${legend}</div>`;
}
function kpiCard(label,value,level,onclick){
