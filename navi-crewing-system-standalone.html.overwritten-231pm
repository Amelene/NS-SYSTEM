const CRP009_PDF_B64 = "";

/* ===== CRP-009 in-browser PDF filler (incremental update, pure JS) ===== */

function crp009PdfB64ToBytes(b64){
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++) bytes[i] = bin.charCodeAt(i);
  return bytes;
}
function crp009PdfBytesToStr(bytes){
  // Byte-for-byte string (each char code 0-255), safe for binary-preserving concatenation
  let s = "";
  const CHUNK = 8192;
  for(let i=0;i<bytes.length;i+=CHUNK){
    s += String.fromCharCode.apply(null, bytes.subarray(i, i+CHUNK));
  }
  return s;
}
function crp009StrToBytes(str){
  const bytes = new Uint8Array(str.length);
  for(let i=0;i<str.length;i++) bytes[i] = str.charCodeAt(i) & 0xFF;
  return bytes;
}
function crp009PdfEscape(s){
  s = String(s==null?"":s);
  // Map to Latin-1/WinAnsi range; replace anything outside it to be safe
  let out = "";
  for(let i=0;i<s.length;i++){
    const c = s.charCodeAt(i);
    out += (c > 255) ? "?" : s[i];
  }
  return out.replace(/\\/g,"\\\\").replace(/\(/g,"\\(").replace(/\)/g,"\\)");
}

function crp009BuildPdfContentStream(rowPairs, whiteoutRects, tableFields){
  const parts = ["q", "1 1 1 rg"];
  for(const [x,y,w,h] of whiteoutRects){
    parts.push(`${x.toFixed(2)} ${y.toFixed(2)} ${w.toFixed(2)} ${h.toFixed(2)} re f`);
  }
  parts.push("0 0 0 rg","0 0 0 RG");

  function drawPair(label, value, labelX, colonX, valueX, y){
    parts.push("BT");
    parts.push("/FNaviB 10 Tf");
    parts.push(`1 0 0 1 ${labelX.toFixed(2)} ${y.toFixed(2)} Tm`);
    parts.push(`(${crp009PdfEscape(label)}) Tj`);
    parts.push("ET");
    parts.push("BT");
    parts.push("/FNaviB 10 Tf");
    parts.push(`1 0 0 1 ${colonX.toFixed(2)} ${y.toFixed(2)} Tm`);
    parts.push("(:) Tj");
    parts.push("ET");
    if(value){
      parts.push("BT");
      parts.push("/FNavi 10 Tf");
      parts.push(`1 0 0 1 ${valueX.toFixed(2)} ${y.toFixed(2)} Tm`);
      parts.push(`(${crp009PdfEscape(value)}) Tj`);
      parts.push("ET");
    }
  }

  for(const [lLabel, lValue, rLabel, rValue, y] of rowPairs){
    if(lLabel) drawPair(lLabel, lValue, 60, 133, 143, y);
    if(rLabel) drawPair(rLabel, rValue, 320, 384, 394, y);
  }

  for(const [x,y,text,size] of tableFields){
    if(!text) continue;
    parts.push("BT");
    parts.push(`/FNavi ${size} Tf`);
    parts.push(`1 0 0 1 ${x.toFixed(2)} ${y.toFixed(2)} Tm`);
    parts.push(`(${crp009PdfEscape(text)}) Tj`);
    parts.push("ET");
  }
  parts.push("Q");
  return parts.join("\n");
}

/* Redraws the orange document-control box (top right of the form) with the
   values from the CRP Form settings, in the template's own Times 7pt style. */
const CRP_DOC_BOX = {x:432.43, y:700.97, w:125.8, h:55.525, textX:439.92, maxW:114, rgb:"0.882 0.396 0.231"};
function crp009TextWidth(text, size, bold){
  try{
    const ctx = (crp009TextWidth.c = crp009TextWidth.c || document.createElement("canvas").getContext("2d"));
    ctx.font = (bold?"bold ":"") + size + "px 'Times New Roman', Times, serif";
    return ctx.measureText(text).width;
  }catch(e){ return text.length * size * 0.5; }
}
function crp009DocBoxStream(doc){
  const b = CRP_DOC_BOX;
  const lines = [
    [`Doc No.: ${doc.docNo}`, true, 742.47],
    [`Issue ${doc.issueNo} / Rev. ${doc.revNo}`, false, 734.22],
    [`Issue Date: ${doc.issueDate}`, false, 726.22],
    [`Authorized By: ${doc.authorizedBy}`, false, 718.22],
    [`Page No. 1 of 1`, false, 710.22],
  ];
  const parts = ["q", `${b.rgb} rg`, `${(b.x+1).toFixed(2)} ${(b.y+3).toFixed(2)} ${(b.w-2).toFixed(2)} ${(b.h-5).toFixed(2)} re f`, "1 1 1 rg"];
  for(const [text, bold, y] of lines){
    let size = 7;
    while(size > 4.5 && crp009TextWidth(text, size, bold) > b.maxW) size -= 0.25;
    parts.push("BT", `/${bold?"FNaviTB":"FNaviT"} ${size.toFixed(2)} Tf`, `1 0 0 1 ${b.textX.toFixed(2)} ${y.toFixed(2)} Tm`, `(${crp009PdfEscape(text)}) Tj`, "ET");
  }
  parts.push("Q");
  return parts.join("\n");
}

function fillCrp009Pdf(originalBytes, values){
  const origStr = crp009PdfBytesToStr(originalBytes);
  const origSize = originalBytes.length;

  const tail = origStr.slice(Math.max(0, origSize-2000));
  const re = /startxref\s+(\d+)/g;
  let m, last = null;
  while((m = re.exec(tail)) !== null) last = m;
  if(!last) throw new Error("startxref not found in PDF");
  const prevXrefOffset = parseInt(last[1], 10);

  const rowYs = [792-121.6, 792-140.6, 792-159.6, 792-178.4, 792-197.4];

  const rowPairs = [
    ["Master", values.master_name||"", "Control No.", values.control_no||"", rowYs[0]],
    ["Date", values.date||"", "Crew Status", values.crew_status||"", rowYs[1]],
    ["Ship Name", values.ship_name||"", "SIRB No.", values.sirb_no||"", rowYs[2]],
    ["Name of Crew", values.name_of_crew||"", "SIRB Expiry", values.sirb_expiry||"", rowYs[3]],
    ["Rank", values.rank||"", "", "", rowYs[4]],
  ];

  const whiteoutRects = [[40, 569, 535, 130]];

  const tableFields = [
    [60,  542, values.employment_status||"", 9.5],
    [230, 542, values.from_date||"", 9.5],
    [393, 542, values.to_date||"", 9.5],
  ];

  let contentStream = crp009BuildPdfContentStream(rowPairs, whiteoutRects, tableFields);
  if(values.doc_control) contentStream += "\n" + crp009DocBoxStream(values.doc_control);

  const fontObjNum = 84;
  const fontObjStr = `${fontObjNum} 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>\nendobj\n`;

  const fontBObjNum = 86;
  const fontBObjStr = `${fontBObjNum} 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>\nendobj\n`;

  const fontTObjStr = `87 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Times-Roman /Encoding /WinAnsiEncoding >>\nendobj\n`;
  const fontTBObjStr = `88 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Times-Bold /Encoding /WinAnsiEncoding >>\nendobj\n`;

  const streamObjNum = 85;
  const streamObjStr = `${streamObjNum} 0 obj\n<< /Length ${contentStream.length} >>\nstream\n${contentStream}\nendstream\nendobj\n`;

  const pageObjNum = 3;
  const pageObjStr =
    `${pageObjNum} 0 obj\n` +
    `<< /Type /Page /Parent 2 0 R ` +
    `/Resources << /ExtGState << /GS5 5 0 R /GS8 8 0 R >> ` +
    `/Font << /F1 6 0 R /F2 9 0 R /F3 14 0 R /F4 18 0 R /F5 20 0 R /FNavi 84 0 R /FNaviB 86 0 R /FNaviT 87 0 R /FNaviTB 88 0 R >> ` +
    `/XObject << /Image16 16 0 R >> ` +
    `/ProcSet [ /PDF /Text /ImageB /ImageC /ImageI ] >> ` +
    `/MediaBox [0 0 612 792] ` +
    `/Contents [4 0 R 85 0 R] ` +
    `/Group << /Type /Group /S /Transparency /CS /DeviceRGB >> ` +
    `/Tabs /S /StructParents 0 >>\n` +
    `endobj\n`;

  const newObjects = [[fontObjNum, fontObjStr],[fontBObjNum, fontBObjStr],[87, fontTObjStr],[88, fontTBObjStr],[streamObjNum, streamObjStr],[pageObjNum, pageObjStr]];

  let bodyStr = "";
  const offsets = {};
  let cursor = origSize;
  for(const [num, objStr] of newObjects){
    offsets[num] = cursor;
    bodyStr += objStr;
    cursor += objStr.length;
  }

  const xrefOffset = origSize + bodyStr.length;
  const numsSorted = Object.keys(offsets).map(Number).sort((a,b)=>a-b);
  let xrefText = "xref\n";
  for(const num of numsSorted){
    xrefText += `${num} 1\n`;
    xrefText += `${String(offsets[num]).padStart(10,"0")} 00000 n \r\n`;
  }
  const newSize = Math.max.apply(null, numsSorted) + 1;
  const trailerText = `trailer\n<< /Size ${newSize} /Root 1 0 R /Info 25 0 R /Prev ${prevXrefOffset} >>\nstartxref\n${xrefOffset}\n%%EOF\n`;

  const fullStr = origStr + bodyStr + xrefText + trailerText;
  return crp009StrToBytes(fullStr);
}



/* ================= CRP-009 Embarkation / Disembarkation / Re-assignment Form ================= */
let crp09SelectedCrewId = null;
let crp09SearchText = "";

function findSirbExpiry(crewId){
  const c = crew.find(x=>x.id===crewId);
  if(c && c.sirbExpiry) return c.sirbExpiry;
  const d = docs.find(x=>x.crewId===crewId && x.category==="Seaman's Book (SIRB)" && x.expiryDate);
  return d ? d.expiryDate : "";
}

/* Document-control box printed on the form (shared by all staff, saved to the database). */
const CRP_DOC_KEY = "navi_crp_doc_v1";
const CRP_DOC_DEFAULT = {docNo:"CRP-009", issueNo:"1", revNo:"0", issueDate:"17/02/2024", authorizedBy:"Richard G. Diodoco"};
function getCrpDoc(){
  let saved = null;
  try{ saved = JSON.parse(navStore.getItem(CRP_DOC_KEY) || "null"); }catch(e){}
  return {...CRP_DOC_DEFAULT, ...(saved || {})};
}
function openCrpDocModal(){
  const d = getCrpDoc();
  document.getElementById("modal-root").innerHTML = `<div class="modal-overlay" onclick="if(event.target===this)closeModal()"><div class="modal-box">
    <div class="modal-title"><h2>Form document control</h2><button class="close-x" onclick="closeModal()">✕</button></div>
    <div class="note-box">These details are printed in the orange box at the top right of every CRP form. Update them when the form is revised. Changes apply to all staff.</div>
    <form id="crpDocForm">
      <div class="field-grid">
        <div class="field"><label>Doc No.</label><input type="text" name="docNo" value="${esc(d.docNo)}" required></div>
        <div class="field"><label>Issue Date</label><input type="text" name="issueDate" value="${esc(d.issueDate)}" placeholder="DD/MM/YYYY"></div>
        <div class="field"><label>Issue No.</label><input type="text" name="issueNo" value="${esc(d.issueNo)}"></div>
        <div class="field"><label>Rev. No.</label><input type="text" name="revNo" value="${esc(d.revNo)}"></div>
        <div class="field full"><label>Authorized By</label><input type="text" name="authorizedBy" value="${esc(d.authorizedBy)}"></div>
      </div>
      <div class="modal-actions">
        <button type="submit" class="save-btn">${icon('save')} Save</button>
        <button type="button" class="cancel-btn" onclick="resetCrpDoc()">Restore original</button>
        <button type="button" class="cancel-btn" onclick="closeModal()">Cancel</button>
      </div>
    </form>
  </div></div>`;
  document.getElementById("crpDocForm").onsubmit = function(e){
    e.preventDefault();
    const obj = {};
    new FormData(e.target).forEach((v,k)=>obj[k]=String(v).trim());
    if(!obj.docNo) return;
    navStore.setItem(CRP_DOC_KEY, JSON.stringify(obj));
    closeModal(); render();
  };
}
function resetCrpDoc(){
  const f = document.getElementById("crpDocForm"); if(!f) return;
  Object.keys(CRP_DOC_DEFAULT).forEach(k=>{ if(f[k]) f[k].value = CRP_DOC_DEFAULT[k]; });
}
function crpDocBoxHtml(){
  const d = getCrpDoc();
  return `<div class="crp-docbox">
    <div class="crp-docbox-lines">
      <div><b>Doc No.: ${esc(d.docNo)}</b></div>
      <div>Issue ${esc(d.issueNo)} / Rev. ${esc(d.revNo)}</div>
      <div>Issue Date: ${esc(d.issueDate)}</div>
      <div>Authorized By: ${esc(d.authorizedBy)}</div>
    </div>
    <button type="button" class="crp-docbox-edit" onclick="openCrpDocModal()" title="Edit document control">${icon('pencil')} Edit</button>
  </div>`;
}

let crp09Form = {date: "", status: "", from: "", to: ""};
const CRP_STATUSES = [
  {value:"EMBARKATION", label:"Embarkation", hint:"Joining a vessel", icon:"download"},
  {value:"DISEMBARKATION", label:"Disembarkation", hint:"Signing off", icon:"upload"},
  {value:"RE-ASSIGNMENT", label:"Re-assignment", hint:"Moving to another vessel", icon:"repeat"},
];
function crpInitials(name){
  const parts = (name||"").replace(/,/g," ").split(/\s+/).filter(Boolean);
  return ((parts[0]||"")[0]||"").toUpperCase() + ((parts[1]||"")[0]||"").toUpperCase();
}
function crpStatusPill(status){
  const s = (status||"").toLowerCase();
  const [bg, fg] = s==="onboard" ? ["#E9F4EE", "#1F6B44"] : /standby|pool/.test(s) ? ["#FBF3DE", "#8A6414"] : ["#F1F1EF", SLATE];
  return status ? `<span class="pill" style="background:${bg};color:${fg};">${esc(status)}</span>` : "";
}
function crpRenderKeepScroll(){
  const list = document.querySelector(".crp-list");
  const top = list ? list.scrollTop : 0;
  render();
  const again = document.querySelector(".crp-list");
  if(again) again.scrollTop = top;
}
function crpSelectCrew(id){ crp09SelectedCrewId = id; crpRenderKeepScroll(); }
function crpSetStatus(value){ crp09Form.status = value; crpRenderKeepScroll(); }

function renderCrp09Tab(){
  if(!crp09Form.date) crp09Form.date = todayStr();
  const selected = crp09SelectedCrewId ? crew.find(c=>c.id===crp09SelectedCrewId) : null;

  const q = crp09SearchText.trim().toLowerCase();
  const all = crew.filter(c=>c.crewName && c.crewName.trim());
  const matches = all.filter(c=>{
    if(!q) return true;
    const hay = [c.crewName,c.vessel,c.position,c.crewControlNo].map(v=>(v||"").toLowerCase()).join(" ");
    return hay.includes(q);
  }).sort((a,b)=>(a.crewName||"").localeCompare(b.crewName||""));

  const listHtml = matches.length ? matches.map(c=>`
    <button type="button" class="crp-person ${c.id===crp09SelectedCrewId?'active':''}" onclick="crpSelectCrew('${c.id}')">
      <span class="crp-avatar">${esc(crpInitials(c.crewName))}</span>
      <span class="crp-person-text">
        <span class="crp-person-name">${esc(c.crewName)}</span>
        <span class="crp-person-meta">${esc(c.position)||'—'} · ${esc(c.vessel)||'No vessel'}</span>
      </span>
      ${c.crewControlNo?`<span class="crp-ccn">${esc(c.crewControlNo)}</span>`:''}
    </button>`).join("") : `<div class="crp-empty-list">No crew match "${esc(crp09SearchText)}".</div>`;

  let right;
  if(!selected){
    right = `<div class="crp-card crp-placeholder">
      <div class="crp-placeholder-icon">${icon('clipboard')}</div>
      <div class="crp-placeholder-title">Select a crew member</div>
      <div class="crp-placeholder-text">Pick someone from the list on the left. Their details from the Crew Roster will be filled into the form automatically.</div>
    </div>`;
  } else {
    const r = selected;
    const sirbExpiry = findSirbExpiry(r.id);
    const vesselMaster = findVesselMaster(r.vessel);
    const missing = '<span class="crp-missing">Not on file</span>';
    const item = (label, value) => `<div class="crp-item"><div class="crp-item-label">${label}</div><div class="crp-item-value">${value || missing}</div></div>`;
    right = `<div class="crp-card">
      <div class="crp-selected">
        <span class="crp-avatar lg">${esc(crpInitials(r.crewName))}</span>
        <div style="flex:1;min-width:0;">
          <div class="crp-selected-name">${esc(r.crewName)}</div>
          <div class="crp-selected-meta">${esc(r.position)||'—'} · ${esc(r.vessel)||'No vessel'} ${crpStatusPill(r.status)}</div>
        </div>
        <button type="button" class="btn-outline" onclick="crpSelectCrew(null)">Change</button>
      </div>

      <div class="crp-section">
        <div class="crp-section-title"><span class="crp-step">1</span> Auto-filled from Crew Roster</div>
        <div class="crp-items">
          ${item("Name of Crew", esc(r.crewName))}
          ${item("Rank", esc(r.position))}
          ${item("Ship Name", esc(r.vessel))}
          ${item("Master", vesselMaster ? esc(vesselMaster.crewName) : '<span class="crp-missing">No Master onboard</span>')}
          ${item("Control No.", esc(r.crewControlNo))}
          ${item("Crew Status", esc(r.status))}
          ${item("SIRB No.", esc(r.sirbNo))}
          ${item("SIRB Expiry", sirbExpiry ? fmtDate(sirbExpiry) : "")}
        </div>
      </div>

      <div class="crp-section">
        <div class="crp-section-title"><span class="crp-step">2</span> Employment status <span style="color:${RED};">*</span></div>
        <input type="hidden" id="crp09EmpStatus" value="${esc(crp09Form.status)}">
        <div class="crp-status-grid">
          ${CRP_STATUSES.map(s=>`
            <button type="button" class="crp-status ${crp09Form.status===s.value?'active':''}" onclick="crpSetStatus('${s.value}')">
              ${icon(s.icon)}
              <span><span class="crp-status-label">${s.label}</span><span class="crp-status-hint">${s.hint}</span></span>
            </button>`).join("")}
        </div>
      </div>

      <div class="crp-section">
        <div class="crp-section-title"><span class="crp-step">3</span> Form details</div>
        <div class="crp-fields">
          <div class="field"><label>Date</label><input type="date" id="crp09Date" value="${esc(crp09Form.date)}" oninput="crp09Form.date=this.value"></div>
          <div class="field"><label>From</label><input type="text" id="crp09From" value="${esc(crp09Form.from)}" oninput="crp09Form.from=this.value" placeholder="Date or port"></div>
          <div class="field"><label>To</label><input type="text" id="crp09To" value="${esc(crp09Form.to)}" oninput="crp09Form.to=this.value" placeholder="Date, vessel or port"></div>
        </div>
      </div>

      <button type="button" class="btn crp-generate" onclick="generateCrp09Pdf()">${icon('download')} Generate &amp; Download CRP Form (PDF)</button>
      <div class="crp-note">${icon('alert')}<span>Signature and confirmation lines (Prepared by, Approved by, Ship Captain, Date, Time, Place/Port, Ship Stamp) are left blank on purpose. Print the form, then fill those in by hand.</span></div>
    </div>`;
  }

  document.getElementById("main").innerHTML = `
    <div class="crp-head">
      <div>
        <h2 class="crp-title">CRP Form</h2>
        <div class="crp-subtitle">Official ${esc(getCrpDoc().docNo)} Embarkation / Disembarkation / Re-assignment form, pre-filled from the Crew Roster.</div>
      </div>
      ${crpDocBoxHtml()}
    </div>
    <div class="crp-layout">
      <div class="crp-card crp-picker">
        <div class="crp-picker-head">
          <div class="crp-section-title" style="margin:0;">Crew member <span class="crp-count">${matches.length} of ${all.length}</span></div>
          <div class="search-wrap" style="min-width:0;flex:none;">
            <span class="icon">${icon('search')}</span>
            <input type="text" id="crp09Search" placeholder="Name, vessel, position or CCN" value="${esc(crp09SearchText)}" oninput="crp09SearchText=this.value;render()" autocomplete="off">
          </div>
        </div>
        <div class="crp-list">${listHtml}</div>
      </div>
      <div>${right}</div>
    </div>`;
}

function generateCrp09Pdf(){
  const r = crew.find(c=>c.id===crp09SelectedCrewId);
  if(!r){ alert("Please select a crew member first."); return; }
  const empStatus = document.getElementById("crp09EmpStatus").value;
  if(!empStatus){ alert("Please select an Employment Status (Embarkation / Disembarkation / Re-assignment)."); return; }
  const dateVal = document.getElementById("crp09Date").value;
  const fromVal = document.getElementById("crp09From").value;
  const toVal = document.getElementById("crp09To").value;
  const sirbExpiry = findSirbExpiry(r.id);
  const vesselMaster = findVesselMaster(r.vessel);

  const values = {
    control_no: r.crewControlNo || "",
    date: dateVal ? fmtDate(dateVal) : "",
    crew_status: r.status || "",
    ship_name: r.vessel || "",
    sirb_no: r.sirbNo || "",
    name_of_crew: r.crewName || "",
    sirb_expiry: sirbExpiry ? fmtDate(sirbExpiry) : "",
    rank: r.position || "",
    master_name: vesselMaster ? vesselMaster.crewName : "",
    employment_status: empStatus,
    from_date: fromVal,
    to_date: toVal,
    doc_control: getCrpDoc(),
  };

  try{
    const originalBytes = crp009PdfB64ToBytes(CRP009_PDF_B64);
    const outBytes = fillCrp009Pdf(originalBytes, values);
    const blob = new Blob([outBytes], {type:"application/pdf"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    const safeName = (r.crewName||"crew").replace(/[^a-z0-9]+/gi,"_");
    const docPrefix = (values.doc_control.docNo||"CRP-009").replace(/[^a-z0-9-]+/gi,"_");
    a.href = url; a.download = docPrefix+"_"+safeName+"_"+empStatus+".pdf";
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }catch(err){
    alert("Could not generate the form: "+err.message);
  }
}

applyStoredLogo();
render();
