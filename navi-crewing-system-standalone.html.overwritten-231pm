/* ================= CSV import/export for Crew Roster ================= */
const CSV_FIELDS = ["crewControlNo","vessel","position","crewName","status","contractType","dob","nationality","contactNo","passportNo","sirbNo","nextOfKin","nextOfKinContact","address","licenseHold","licenseRequired","embarkDate","embarkPort","coeEnd","extEnd","actualDisembarkDate","disembarkPort","remarks","relieverName","relieverContact","relieverLicense","relieverStatus","nfr","nfrReason","illness","illnessNotes","incidentCount","accidentCount"];
const FIELD_LABELS = {
  crewControlNo:"Crew Control No.",
  vessel:"Vessel Name", position:"Position / Rank", crewName:"Full Name (Surname, First Name)",
  status:"Crew Status", contractType:"Contract Type", dob:"Date of Birth",
  nationality:"Nationality", contactNo:"Contact Number", passportNo:"Passport No.",
  sirbNo:"SIRB / Seaman's Book No.", nextOfKin:"Next of Kin - Name", nextOfKinContact:"Next of Kin - Contact No.",
  address:"Home Address", licenseHold:"License Currently Held", licenseRequired:"License Required for Position",
  embarkDate:"Embarkation Date", embarkPort:"Port of Embarkation", coeEnd:"COE End Date",
  extEnd:"Extension End Date (if any)", actualDisembarkDate:"Actual Disembarkation Date (if applicable)",
  disembarkPort:"Port of Disembarkation", remarks:"Remarks",
  relieverName:"Reliever - Full Name", relieverContact:"Reliever - Contact No.", relieverLicense:"Reliever - License",
  relieverStatus:"Reliever Status", nfr:"Not for Rehire? (TRUE/FALSE)", nfrReason:"NFR Reason (if applicable)",
  illness:"Currently Reported Ill? (TRUE/FALSE)", illnessNotes:"Illness Notes (if applicable)",
  incidentCount:"Number of Incidents Reported", accidentCount:"Number of Accidents Reported",
};
function normalizeHeader(h){ return (h||"").toString().trim().toLowerCase().replace(/[^a-z0-9]/g,""); }
const LABEL_TO_FIELD = {};
Object.keys(FIELD_LABELS).forEach(k=>{
  LABEL_TO_FIELD[normalizeHeader(k)] = k;
  LABEL_TO_FIELD[normalizeHeader(FIELD_LABELS[k])] = k;
});
function resolveHeader(h){ return LABEL_TO_FIELD[normalizeHeader(h)] || null; }
function csvEscape(v){
  v = (v===undefined||v===null) ? "" : String(v);
  if(/[",\n]/.test(v)) return '"' + v.replace(/"/g,'""') + '"';
  return v;
}
function exportCrewCsv(){
  const rows = [CSV_FIELDS.join(",")];
  crew.forEach(c=>{ rows.push(CSV_FIELDS.map(f=>csvEscape(c[f])).join(",")); });
  const blob = new Blob([rows.join("\n")], {type:"text/csv"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = "navi-crew-roster.csv";
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
function parseCsv(text){
  const rows = []; let row=[]; let field=""; let inQuotes=false;
  for(let i=0;i<text.length;i++){
    const c = text[i];
    if(inQuotes){
      if(c==='"'){ if(text[i+1]==='"'){ field+='"'; i++; } else { inQuotes=false; } }
      else field += c;
    } else {
      if(c==='"') inQuotes = true;
      else if(c===','){ row.push(field); field=""; }
      else if(c==='\n' || c==='\r'){
        if(c==='\r' && text[i+1]==='\n') i++;
        row.push(field); rows.push(row); row=[]; field="";
      } else field += c;
    }
  }
  if(field.length || row.length){ row.push(field); rows.push(row); }
  return rows.filter(r => !(r.length===1 && r[0]===""));
}
function importCrewCsv(evt){
  const file = evt.target.files[0]; if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    try{
      const rows = parseCsv(e.target.result);
      if(rows.length < 2){ alert("That CSV doesn't have any data rows."); return; }
      const rawHeaders = rows[0].map(h=>h.trim());
      const resolved = rawHeaders.map(h=>resolveHeader(h));
      const unrecognized = rawHeaders.filter((h,i)=>h && !resolved[i]);
      if(!resolved.includes("vessel") || !resolved.includes("position")){
        alert("This file is missing the required 'Vessel Name' and/or 'Position / Rank' columns (or their headers don't match what the system recognizes).\n\nUse 'Export crew (.csv)' for the raw format, or ask for the fillable Crew Data Form template, and don't rename its column headers.");
        return;
      }
      const newRecords = rows.slice(1).map(r=>{
        const obj = {};
        resolved.forEach((field,i)=>{ if(field) obj[field] = r[i]!==undefined ? r[i] : ""; });
        obj.nfr = /^(true|1|yes)$/i.test(obj.nfr||"");
        obj.illness = /^(true|1|yes)$/i.test(obj.illness||"");
        obj.incidentCount = Number(obj.incidentCount)||0;
        obj.accidentCount = Number(obj.accidentCount)||0;
        obj.id = uid("crew");
        return obj;
      }).filter(r=>r.vessel && r.vessel.trim());
      if(!newRecords.length){ alert("No valid rows found (each row needs at least a Vessel Name value)."); return; }

      const proceedToModeChoice = ()=>{
        document.getElementById("modal-root").innerHTML += `
        <div class="modal-overlay" id="csvModeOverlay" onclick="document.getElementById('csvModeOverlay').remove()">
          <div class="modal-box" style="max-width:420px;" onclick="event.stopPropagation()">
            <div class="modal-title"><h2>Import ${newRecords.length} crew record(s)</h2><button class="close-x" onclick="document.getElementById('csvModeOverlay').remove()">✕</button></div>
            <p style="font-size:13px;color:${SLATE};margin-bottom:16px;">Add these to your current roster, or replace the entire roster with just this file's contents?</p>
            <div style="display:flex;flex-direction:column;gap:8px;">
              <button class="save-btn" style="flex:none;" onclick="finishCsvImport(window.__pendingCsvRecords,'add')">➕ Add to existing roster</button>
              <button style="background:${RED};color:#fff;border:none;border-radius:10px;padding:11px;font-size:14px;font-weight:700;cursor:pointer;" onclick="finishCsvImport(window.__pendingCsvRecords,'replace')">${icon('alert')} Replace entire roster</button>
              <button class="cancel-btn" onclick="document.getElementById('csvModeOverlay').remove()">Cancel</button>
            </div>
          </div>
        </div>`;
      };
      window.__pendingCsvRecords = newRecords;

      if(unrecognized.length){
        showConfirm("Some columns weren't recognized", `These column(s) will be ignored: ${unrecognized.join(", ")}. Continue importing the recognized columns anyway?`, proceedToModeChoice);
      } else {
        proceedToModeChoice();
      }
    }catch(err){ alert("Could not read that file as CSV. Make sure it was saved as .csv (in Excel: File → Save As → CSV)."); }
  };
  reader.readAsText(file);
  evt.target.value = "";
}
function finishCsvImport(newRecords, mode){
  crew = mode==="add" ? [...crew, ...newRecords] : newRecords;
  backfillCrewControlNumbers();
  const overlay = document.getElementById("csvModeOverlay"); if(overlay) overlay.remove();
  window.__pendingCsvRecords = null;
  persistCrew();
  alert(`Imported ${newRecords.length} crew record(s). Please review them in the Crew Roster tab to verify correctness before treating them as final.`);
}

