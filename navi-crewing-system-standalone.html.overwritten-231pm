<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>NAVI Shipping — Crewing System</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script src="config.js"></script>
<script src="cloud-sync.js"></script>
<script>
/* Login gate: only signed-in staff can see this page; everyone else goes to index.html.
   Once signed in, all data is loaded from Supabase (cloud-sync.js) before the app starts. */
document.documentElement.style.visibility = "hidden";
var authDb = null;
(function(){
  function toLogin(){ location.replace("index.html"); }
  try{
    authDb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  }catch(e){ toLogin(); return; }
  var domReady = new Promise(function(r){
    if(document.readyState !== "loading") r(); else document.addEventListener("DOMContentLoaded", r);
  });
  authDb.auth.getSession().then(async function(res){
    var session = res.data && res.data.session;
    if(!session){ toLogin(); return; }
    await domReady;
    document.documentElement.style.visibility = "";
    var el = document.getElementById("signedInAs");
    if(el) el.textContent = session.user.email;
    startApp(session.user);
  }).catch(toLogin);

  function showLoading(html){
    var ov = document.getElementById("cloudLoading");
    if(!ov){
      ov = document.createElement("div");
      ov.id = "cloudLoading";
      ov.style.cssText = "position:fixed;inset:0;z-index:9999;background:#F6F4EF;display:flex;align-items:center;justify-content:center;padding:24px;font-family:Arial,Helvetica,sans-serif;color:#0B4650;text-align:center;";
      document.body.appendChild(ov);
    }
    ov.innerHTML = '<div style="max-width:520px;font-size:15px;line-height:1.5;">' + html + '</div>';
    return ov;
  }
  function escHtml(s){ return String(s || "").replace(/[&<>"']/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); }

  async function startApp(user){
    var ov = showLoading("<b>Loading data from the database…</b>");
    try{
      await NaviCloud.boot(authDb, user, function(msg){ showLoading("<b>" + escHtml(msg) + "</b>"); });
    }catch(e){
      console.error(e);
      var msg = (e && e.message) || String(e);
      var missing = /navi_records|navi_settings|schema cache|does not exist|bucket not found/i.test(msg);
      showLoading(
        '<div style="font-size:18px;font-weight:800;margin-bottom:8px;">Couldn\'t load data from the database</div>' +
        (missing
          ? '<p>The database tables for this page haven\'t been created yet. Open <b>Supabase Dashboard → SQL Editor</b>, paste in the contents of <b>supabase-setup.sql</b>, click <b>Run</b>, then retry.</p>'
          : '<p>Check your internet connection and try again.</p>') +
        '<p style="font-size:12px;color:#5B6B6E;">' + escHtml(msg) + '</p>' +
        '<button id="cloudRetry" style="background:#0B4650;color:#fff;border:none;border-radius:10px;padding:10px 18px;font-weight:700;cursor:pointer;">Retry</button>'
      );
      document.getElementById("cloudRetry").onclick = function(){ startApp(user); };
      return;
    }
    ov.remove();
    var app = document.createElement("script");
    app.textContent = document.getElementById("naviApp").textContent;
    document.body.appendChild(app);
  }
})();
function closeDataMenu(){ var m = document.getElementById("dataMenu"); if(m) m.open = false; }
document.addEventListener("click", function(e){
  var m = document.getElementById("dataMenu");
  if(m && m.open && !m.contains(e.target)) m.open = false;
});
async function signOut(){
  try{ if(authDb) await authDb.auth.signOut(); }catch(e){}
  location.replace("index.html");
}
</script>
<style>
  :root{
    --navy:#0B4650; --navy-deep:#08343C; --teal:#146B78; --orange:#E8734A;
    --cream:#F6F4EF; --red:#C4392B; --amber:#D98A1F; --green:#2E8B57; --slate:#5B6B6E;
    --purple:#6B4E9E;
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--cream);color:#1D2A2C;}
  header{background:linear-gradient(135deg,var(--navy-deep) 0%,var(--navy) 55%,var(--teal) 100%);padding:20px;}
  .header-inner{max-width:1280px;margin:0 auto;}
  .brand{display:flex;align-items:center;gap:12px;margin-bottom:14px;}
  .brand svg{flex-shrink:0;}
  .logo-wrap{width:46px;height:46px;flex-shrink:0;cursor:pointer;border-radius:9px;overflow:hidden;position:relative;}
  .logo-wrap:hover::after{content:"✎";position:absolute;inset:0;background:rgba(0,0,0,.4);color:#fff;display:flex;align-items:center;justify-content:center;font-size:16px;}
  .logo-wrap img{width:46px;height:46px;object-fit:contain;background:#fff;border-radius:9px;}
  .brand h1{color:#fff;font-size:22px;margin:0;font-weight:800;}
  .brand p{color:#B9D8D6;font-size:12.5px;margin:3px 0 0;}
  .tabs{display:flex;gap:4px;flex-wrap:wrap;}
  .tab-btn{display:flex;align-items:center;gap:6px;padding:9px 15px;background:transparent;color:#CFEAE9;border:none;border-radius:10px 10px 0 0;font-size:13px;font-weight:700;cursor:pointer;}
  .tab-btn.active{background:var(--cream);color:var(--navy);}
  main{max-width:1280px;margin:0 auto;padding:18px 16px 60px;}
  .section-title{display:flex;align-items:center;justify-content:space-between;margin:16px 0 10px;font-weight:800;color:var(--navy);font-size:14px;}
  .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:20px;}
  .kpi-card{background:#fff;border:1.5px solid #E5E0D3;border-radius:12px;padding:12px 14px;cursor:pointer;text-align:left;}
  .kpi-card .val{font-size:22px;font-weight:800;}
  .kpi-card .lbl{font-size:11.5px;color:var(--slate);font-weight:600;margin-top:2px;}
  .gauge-bar{display:flex;height:22px;border-radius:8px;overflow:hidden;background:#EDEAE0;margin-bottom:8px;}
  .gauge-legend{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:12px;margin-bottom:20px;}
  .gauge-legend span.dot{width:9px;height:9px;border-radius:3px;display:inline-block;margin-right:5px;}
  .count-tile{flex:1 1 120px;background:#fff;border-radius:10px;padding:12px 14px;border-left:4px solid;}
  .count-tile .val{font-size:22px;font-weight:800;}
  .count-tile .lbl{font-size:11.5px;color:var(--slate);font-weight:600;}
  .row-flex{display:flex;gap:10px;flex-wrap:wrap;}
  .controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:16px;}
  input[type=text],input[type=search],select,textarea{padding:9px 12px;border-radius:9px;border:1px solid #D8D3C7;font-size:13.5px;font-family:inherit;}
  .search-wrap{position:relative;flex:1 1 220px;min-width:200px;}
  .search-wrap input{width:100%;padding-left:32px;box-sizing:border-box;}
  .search-wrap .icon{position:absolute;left:11px;top:9px;color:var(--slate);}
  button.btn{display:flex;align-items:center;gap:6px;background:var(--orange);color:#fff;border:none;border-radius:9px;padding:9px 16px;font-size:13.5px;font-weight:700;cursor:pointer;}
  button.btn-outline{background:transparent;color:var(--slate);border:1px solid #D8D3C7;border-radius:9px;padding:9px 12px;font-size:12.5px;cursor:pointer;}
  .legend-row{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:18px;font-size:12px;color:var(--slate);}
  .vessel-card{margin-bottom:16px;background:#fff;border-radius:14px;border:1px solid #E5E0D3;overflow:hidden;}
  .vessel-head{width:100%;display:flex;align-items:center;justify-content:space-between;padding:13px 16px;background:var(--navy);border:none;cursor:pointer;color:#fff;font-weight:700;font-size:14.5px;}
  .vessel-head .badge{background:rgba(255,255,255,.15);color:#CFEAE9;font-size:11.5px;padding:2px 8px;border-radius:999px;margin-left:8px;}
  .crew-row{padding:12px 16px;border-top:1px solid #EEEAE0;display:flex;gap:12px;align-items:flex-start;cursor:pointer;}
  .crew-row .bar{width:4px;align-self:stretch;border-radius:4px;flex-shrink:0;}
  .crew-row .main{flex:1;min-width:0;}
  .crew-row .title-line{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:4px;}
  .pill{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:999px;}
  .meta-line{display:flex;flex-wrap:wrap;gap:4px 16px;font-size:12.5px;color:var(--slate);}
  .icon-btn{width:30px;height:30px;border-radius:8px;border:1px solid #E5E0D3;background:#fff;color:var(--slate);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;}
  .icon-btn.danger{color:var(--red);}
  .expand-detail{padding:0 16px 16px 32px;font-size:12.5px;color:#3C4A4C;}
  .detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 16px;}
  .modal-overlay{position:fixed;inset:0;background:rgba(8,20,22,.55);display:flex;align-items:flex-end;justify-content:center;z-index:50;}
  .modal-box{background:#fff;width:100%;max-width:680px;max-height:90vh;overflow-y:auto;border-radius:16px 16px 0 0;padding:20px;}
  .modal-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;}
  .modal-title h2{font-size:17px;font-weight:800;color:var(--navy);margin:0;}
  .close-x{background:none;border:none;cursor:pointer;color:var(--slate);font-size:18px;}
  .field-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .field{margin-bottom:10px;}
  .field.full{grid-column:1/-1;}
  .field label{display:block;font-size:11.5px;font-weight:700;color:var(--slate);margin-bottom:4px;}
  .field input,.field select,.field textarea{width:100%;box-sizing:border-box;}
  .field-section-title{font-size:11.5px;font-weight:700;color:var(--teal);text-transform:uppercase;margin:12px 0 6px;}
  .modal-actions{display:flex;gap:10px;margin-top:20px;}
  .modal-actions button{flex:1;padding:11px;border-radius:10px;font-size:14px;font-weight:700;border:none;cursor:pointer;}
  .save-btn{background:var(--orange);color:#fff;}
  .cancel-btn{background:#F1F1EF;color:#3C4A4C;}
  .confirm-box{background:#fff;border-radius:14px;padding:20px;max-width:360px;width:100%;}
  .empty-state{text-align:center;padding:50px 20px;color:var(--slate);font-size:14px;}
  .note-box{font-size:12px;color:var(--slate);background:#EEF3F1;border:1px solid #DCEAE4;border-radius:10px;padding:9px 12px;margin-bottom:16px;}
  .log-entry{display:flex;align-items:center;gap:10px;font-size:12.5px;padding:7px 12px;background:#fff;border:1px solid #E5E0D3;border-radius:8px;margin-bottom:6px;flex-wrap:wrap;}
  .checkbox-field{display:flex;align-items:center;gap:8px;padding-top:18px;}
  .toolbar-right{display:flex;gap:8px;flex-wrap:wrap;margin-left:auto;}
  .brand{flex-wrap:wrap;}
  .ic{width:1.15em;height:1.15em;flex-shrink:0;vertical-align:-0.2em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
  .section-title{justify-content:flex-start;gap:8px;}
  .section-title > .ic{color:var(--teal);width:18px;height:18px;}
  .section-title > :last-child:not(.ic){margin-left:auto;}
  .tab-btn .ic{width:16px;height:16px;opacity:.9;}
  .icon-btn{gap:6px;}
  .icon-btn .ic{width:15px;height:15px;}
  button.btn-outline, .save-btn, .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;}
  .search-wrap .icon{top:50%;transform:translateY(-50%);display:flex;}
  .search-wrap .icon .ic{width:15px;height:15px;}
  .menu-item .ic{width:15px;height:15px;color:var(--teal);}
  /* Inputs without an explicit type (and date/number) get the same look as text inputs */
  input:not([type]), input[type=date], input[type=number], input[type=email], input[type=tel]{padding:9px 12px;border-radius:9px;border:1px solid #D8D3C7;font-size:13.5px;font-family:inherit;background:#fff;color:#1D2A2C;}
  input:focus, select:focus, textarea:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(20,107,120,.14);}
  textarea{resize:vertical;}
  @media (min-width:720px){
    .modal-overlay{align-items:center;padding:24px;}
    .modal-box{border-radius:16px;max-height:calc(100vh - 48px);}
  }
  .field-grid.cols-3{grid-template-columns:repeat(3,1fr);}
  @media (max-width:560px){ .field-grid.cols-3{grid-template-columns:1fr 1fr;} }
  .form-section{padding:4px 0 10px;border-bottom:1px solid #F1EEE4;margin-bottom:6px;}
  .form-section:last-of-type{border-bottom:none;}
  .file-pick{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:#FBFAF7;border:1px dashed #D8D3C7;border-radius:10px;padding:10px 12px;margin-top:2px;}
  .file-pick-btn{cursor:pointer;display:inline-flex;align-items:center;gap:6px;background:#fff;color:var(--navy);border:1px solid #D8D3C7;border-radius:9px;padding:8px 12px;font-size:12.5px;font-weight:700;}
  .file-pick-status{font-size:12.5px;color:#1D2A2C;display:flex;align-items:center;gap:5px;}
  .file-pick-hint{font-size:11.5px;color:var(--slate);margin-top:2px;}
  /* Shared page header */
  .page-head{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin:4px 0 16px;}
  .page-head > div:first-child{flex:1;min-width:240px;}
  .page-title{margin:0;font-size:20px;font-weight:800;color:var(--navy);}
  .page-subtitle{font-size:13px;color:var(--slate);margin-top:3px;}
  /* Vessels tab */
  .vsl-picker{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;margin-bottom:16px;}
  .vsl-pick{display:flex;align-items:flex-start;gap:11px;padding:12px 14px;background:#fff;border:1.5px solid #E5E0D3;border-radius:12px;cursor:pointer;text-align:left;font-family:inherit;color:inherit;}
  .vsl-pick:hover{border-color:#BFDCD8;}
  .vsl-pick.active{border-color:var(--teal);background:#F4FAF9;box-shadow:0 0 0 3px rgba(20,107,120,.12);}
  .vsl-pick-icon{width:36px;height:36px;border-radius:10px;background:#E3EFED;color:var(--teal);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .vsl-pick.active .vsl-pick-icon{background:var(--teal);color:#fff;}
  .vsl-pick-icon .ic{width:19px;height:19px;}
  .vsl-pick-text{display:flex;flex-direction:column;min-width:0;flex:1;}
  .vsl-pick-name{font-size:14px;font-weight:800;color:var(--navy);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .vsl-pick-sub{font-size:11.5px;color:var(--slate);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .vsl-pick-meta{display:flex;gap:12px;margin-top:7px;font-size:11px;font-weight:700;color:var(--slate);}
  .vsl-pick-meta > span{display:inline-flex;align-items:center;gap:4px;}
  .vsl-pick-meta .ic{width:13px;height:13px;}
  .vsl-dot{width:8px;height:8px;border-radius:50%;display:inline-block;}
  .vsl-head{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding-bottom:16px;border-bottom:1px solid #EEEAE0;}
  .vsl-head-icon{width:48px;height:48px;border-radius:13px;background:var(--teal);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .vsl-head-icon .ic{width:24px;height:24px;}
  .vsl-name{font-size:18px;font-weight:800;color:var(--navy);}
  .vsl-sub{font-size:12.5px;color:var(--slate);margin-top:3px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .vsl-actions{display:flex;gap:8px;align-items:center;}
  .vsl-actions .icon-btn{width:36px;height:36px;}
  .vsl-stats{grid-template-columns:repeat(auto-fit,minmax(120px,1fr));}
  .vsl-stats .crp-item-value{font-size:16px;font-weight:800;color:var(--navy);}
  .vsl-unit{font-size:11px;font-weight:600;color:var(--slate);}
  .vsl-empty{color:#A9A69C;font-weight:500;}
  .vsl-cert{display:flex;gap:12px;align-items:center;flex-wrap:wrap;}
  .vsl-cert-file{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:12.5px;}
  .vsl-crew{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px;}
  .vsl-crew-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid #EEEAE0;border-radius:10px;background:#FBFAF7;}
  .vsl-crew-item .crp-avatar{width:32px;height:32px;font-size:11.5px;}
  /* CRP Form tab */
  .crp-head{margin:4px 0 16px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
  .crp-head > div:first-child{flex:1;min-width:240px;}
  .crp-docbox{display:flex;align-items:stretch;background:#E1653B;color:#fff;border-radius:10px;overflow:hidden;font-family:'Times New Roman',Times,serif;font-size:12px;line-height:1.35;box-shadow:0 1px 2px rgba(0,0,0,.08);}
  .crp-docbox-lines{padding:8px 14px;}
  .crp-docbox-edit{display:flex;align-items:center;gap:5px;background:rgba(0,0,0,.12);color:#fff;border:none;border-left:1px solid rgba(255,255,255,.25);padding:0 14px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;cursor:pointer;}
  .crp-docbox-edit:hover{background:rgba(0,0,0,.22);}
  .crp-title{margin:0;font-size:20px;font-weight:800;color:var(--navy);}
  .crp-subtitle{font-size:13px;color:var(--slate);margin-top:3px;}
  .crp-layout{display:grid;grid-template-columns:minmax(280px,380px) 1fr;gap:18px;align-items:start;}
  @media (max-width:820px){ .crp-layout{grid-template-columns:1fr;} }
  .crp-card{background:#fff;border:1px solid #E5E0D3;border-radius:14px;padding:18px;}
  .crp-picker{padding:0;overflow:hidden;position:sticky;top:12px;}
  .crp-picker-head{padding:14px 14px 12px;border-bottom:1px solid #EEEAE0;display:flex;flex-direction:column;gap:10px;}
  .crp-count{margin-left:auto;font-size:11.5px;font-weight:600;color:var(--slate);}
  .crp-list{max-height:560px;overflow-y:auto;padding:6px;}
  .crp-person{display:flex;align-items:center;gap:11px;width:100%;padding:9px 10px;border:1px solid transparent;border-radius:10px;background:none;cursor:pointer;text-align:left;font-family:inherit;color:inherit;}
  .crp-person:hover{background:#F6F4EF;}
  .crp-person.active{background:#EAF4F3;border-color:#BFDCD8;}
  .crp-avatar{width:36px;height:36px;border-radius:50%;background:#E3EFED;color:var(--teal);display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:800;flex-shrink:0;}
  .crp-avatar.lg{width:48px;height:48px;font-size:16px;background:var(--teal);color:#fff;}
  .crp-person.active .crp-avatar{background:var(--teal);color:#fff;}
  .crp-person-text{flex:1;min-width:0;display:flex;flex-direction:column;}
  .crp-person-name{font-size:13.5px;font-weight:700;color:#1D2A2C;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .crp-person-meta{font-size:11.5px;color:var(--slate);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .crp-ccn{font-size:10.5px;font-weight:700;color:var(--slate);background:#F1F1EF;border-radius:6px;padding:2px 6px;flex-shrink:0;}
  .crp-empty-list{padding:18px;color:var(--slate);font-size:13px;text-align:center;}
  .crp-placeholder{text-align:center;padding:56px 24px;}
  .crp-placeholder-icon{width:56px;height:56px;border-radius:16px;background:#EAF4F3;color:var(--teal);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;}
  .crp-placeholder-icon .ic{width:26px;height:26px;}
  .crp-placeholder-title{font-size:16px;font-weight:800;color:var(--navy);}
  .crp-placeholder-text{font-size:13px;color:var(--slate);max-width:360px;margin:6px auto 0;line-height:1.5;}
  .crp-selected{display:flex;align-items:center;gap:14px;padding-bottom:16px;border-bottom:1px solid #EEEAE0;}
  .crp-selected-name{font-size:17px;font-weight:800;color:var(--navy);}
  .crp-selected-meta{font-size:12.5px;color:var(--slate);margin-top:3px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .crp-section{padding-top:16px;}
  .crp-section-title{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800;color:var(--navy);text-transform:uppercase;letter-spacing:.03em;margin-bottom:10px;}
  .crp-step{width:20px;height:20px;border-radius:50%;background:var(--navy);color:#fff;font-size:11px;display:inline-flex;align-items:center;justify-content:center;}
  .crp-items{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:0;background:#FBFAF7;border:1px solid #EEEAE0;border-radius:10px;overflow:hidden;}
  .crp-item{background:#FBFAF7;padding:9px 12px;box-shadow:1px 0 0 #EEEAE0, 0 1px 0 #EEEAE0;}
  .crp-item-label{font-size:10.5px;font-weight:700;color:var(--slate);text-transform:uppercase;letter-spacing:.03em;}
  .crp-item-value{font-size:13.5px;font-weight:600;color:#1D2A2C;margin-top:2px;word-break:break-word;}
