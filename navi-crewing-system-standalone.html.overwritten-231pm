  .crew-doc th{background:#eee;}
  .crew-doc .p-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px 20px;font-size:11.5px;}
  .crew-doc .p-footer{margin-top:20px;font-size:9.5px;color:#777;border-top:1px solid #ccc;padding-top:6px;}
