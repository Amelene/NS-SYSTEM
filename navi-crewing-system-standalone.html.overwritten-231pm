function dateInputHtml(name, value){
  const v = value || "";
  const type = (!v || /^\d{4}-\d{2}-\d{2}$/.test(v)) ? "date" : "text";
  return `<input type="${type}" name="${name}" value="${esc(v)}"${type==="text"?' placeholder="YYYY-MM-DD"':''}>`;
}
function vesselOnboard(v){
  const name = (v.name||"").trim().toLowerCase();
  return crew.filter(c=>(c.vessel||"").trim().toLowerCase()===name && c.status==="Onboard");
}
function vesselCertState(v){
  if(!v.certExpiryDate) return {level:"none", label:"No certificate"};
  const u = urgencyOf({expiryDate:v.certExpiryDate});
  if(u.level==="overdue") return {level:"overdue", label:"Certificate expired"};
  if(u.level==="critical"||u.level==="soon") return {level:u.level, label:`Expires in ${u.days}d`};
  return {level:u.level, label:"Certificate valid"};
}
function vesselFilledCount(v){
  return ["vesselType","homePort","marinaRegNo","grt","nrt","loa","breadth","depth","dwt","engineKW"].filter(k=>(v[k]||"").toString().trim()).length;
}

