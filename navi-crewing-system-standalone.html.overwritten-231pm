function effectiveDue(r){ return r.actualDisembarkDate || r.extEnd || r.coeEnd || r.expiryDate || ""; }
function urgencyOf(r){
  const ds = effectiveDue(r);
  if(!ds) return {level:"none", days:null, label:"No date on file"};
  const days = daysUntil(ds);
  if(days===null) return {level:"none",days:null,label:"Unparsed date"};
  if(days<0) return {level:"overdue",days,label:`Overdue ${Math.abs(days)}d`};
  if(days<=7) return {level:"critical",days,label:`Due in ${days}d`};
  if(days<=30) return {level:"soon",days,label:`Due in ${days}d`};
  return {level:"stable",days,label:`Due in ${days}d`};
}
const LEVEL_STYLE = {
  overdue:{bg:"#FDEBE9",border:RED,text:RED,dot:RED,label:"Overdue"},
  critical:{bg:"#FCEFE3",border:ORANGE,text:"#9A4A24",dot:ORANGE,label:"≤ 7 days"},
  soon:{bg:"#FBF3DE",border:AMBER,text:"#8A6414",dot:AMBER,label:"≤ 30 days"},
  stable:{bg:"#E9F4EE",border:GREEN,text:"#1F6B44",dot:GREEN,label:"Stable"},
  none:{bg:"#F1F1EF",border:SLATE,text:SLATE,dot:SLATE,label:"No date"},
};
const LEVEL_ORDER={overdue:0,critical:1,soon:2,none:3,stable:4};
function contractBucket(r){
  if(r.status!=="Onboard") return null;
  const days = daysUntil(effectiveDue(r)); if(days===null) return null;
  if(days<0) return "overdue"; if(days<=30) return "m1"; if(days<=60) return "m2"; if(days<=90) return "m3"; return "beyond";
}
function esc(s){ return (s||"").toString().replace(/[&<>"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function uid(prefix){ return prefix+"-"+Date.now()+"-"+Math.floor(Math.random()*1000); }

/* ================= Export / Import ================= */
function exportData(){
  const blob = new Blob([JSON.stringify({crew,docs,log,exportedAt:new Date().toISOString()},null,2)], {type:"application/json"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = "navi-crewing-data-"+new Date().toISOString().slice(0,10)+".json";
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
function importData(evt){
  const file = evt.target.files[0]; if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    let data;
    try{ data = JSON.parse(e.target.result); }
    catch(err){ alert("That file couldn't be read as valid NAVI crewing data."); return; }
    showConfirm("Import this file?", "This will replace all current crew, document, and log data in the database for everyone.", ()=>{
      crew = data.crew || crew; docs = data.docs || docs; log = data.log || log;
      save(CREW_KEY,crew); save(DOC_KEY,docs); save(LOG_KEY,log);
      render();
    });
  };
  reader.readAsText(file);
  evt.target.value = "";
}

