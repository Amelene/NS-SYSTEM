/* ================= Render dispatcher ================= */
function render(){
  const active = document.activeElement;
  let focusInfo = null;
  if(active && active.id && document.getElementById("main") && document.getElementById("main").contains(active)){
    focusInfo = {id: active.id, start: active.selectionStart, end: active.selectionEnd};
  }
  try{
    renderTabs();
    let banner = "";
    if(!STORAGE_OK){
      banner = `<div class="note-box" style="border-color:${AMBER};background:#FBF3DE;color:#8A6414;">
        ${icon('alert')} This browser/viewer isn't allowing local storage, so nothing will be saved automatically here — use <strong>Export</strong> after making changes, and <strong>Import</strong> to restore them next time. If you're viewing this via a file preview (not a full browser), try opening it in Chrome or Safari's browsing mode instead of a Quick Look-style preview for full functionality.
      </div>`;
    }
    if(activeTab==="dashboard") renderDashboard();
    else if(activeTab==="crew") renderCrewTab();
    else if(activeTab==="vessels") renderVesselsTab();
    else if(activeTab==="crp09") renderCrp09Tab();
    else renderDocsTab();
    if(banner) document.getElementById("main").insertAdjacentHTML("afterbegin", banner);
  }catch(err){
    document.getElementById("main").innerHTML = `<div style="padding:30px;color:#C4392B;font-family:monospace;white-space:pre-wrap;background:#fff;border-radius:12px;border:1px solid #F8D7D3;">
      <strong>Something went wrong rendering this page.</strong>\n\nError: ${esc(err.message||String(err))}\n\nThis text is here so it can be reported instead of showing a blank page.
    </div>`;
  }
  if(focusInfo){
    const el = document.getElementById(focusInfo.id);
    if(el){
      el.focus();
      if(typeof el.setSelectionRange === "function" && focusInfo.start!=null){
        try{ el.setSelectionRange(focusInfo.start, focusInfo.end); }catch(e){}
      }
    }
  }
}

