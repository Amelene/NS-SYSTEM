  .svc-table{width:100%;border-collapse:collapse;font-size:12px;margin-top:8px;}
  .svc-table th{background:#EEF3F1;color:var(--navy);font-weight:700;padding:6px 8px;text-align:left;border-bottom:2px solid #DCEAE4;}
  .svc-table td{padding:6px 8px;border-bottom:1px solid #EEEAE0;vertical-align:top;}
  .svc-table tr.current-row{background:#F1F6F4;}
  #printArea{display:none;}
  .crew-doc{font-family:Arial,Helvetica,sans-serif;color:#111;}
  .crew-doc h1{font-size:19px;margin:0 0 2px;color:#0B4650;}
