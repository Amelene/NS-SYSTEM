function guessPositionGroup(position){
  const p = (position||"").toUpperCase();
  if(!p) return "DECK_RATING";
  if(p.includes("MASTER") || p.includes("MAJOR PATRON")) return "MASTER";
  if(p.includes("CHIEF MATE") || p.includes("2ND MATE") || p.includes("3RD MATE") || p.includes("OIC")) return "DECK_OFFICER";
  if(p.includes("CHIEF ENGINEER")) return "CHIEF_ENGINEER";
  if(p.includes("2ND ENGINEER")) return "SECOND_ENGINEER";
  if(p.includes("MDM")) return "MDM";
  if(p.includes("MOTORMAN") || p.includes("OILER")) return "MOTORMAN";
  if(p.includes("BOAT CAPTAIN") || p.includes("BC1") || p.includes("BC2") || p.includes("BC3")) return "BOAT_CAPTAIN";
  if(p.includes("RADIO")) return "RADIO_OPERATOR";
  if(p.includes("COOK") || p.includes("STEWARD")) return "COOK_STEWARD";
  if(p.includes("DECK CADET")) return "DECK_CADET";
  if(p.includes("ENGINE CADET") || p.includes("OILER/CADET") || p.includes("OILER CADET")) return "ENGINE_CADET";
  if(p.includes("AB") || p.includes("OS") || p.includes("BOSUN") || p.includes("CADET")) return "DECK_RATING";
  return "DECK_RATING";
}
function docTitleMatches(docTitle, reqTitle){
  return (docTitle||"").trim().toLowerCase() === (reqTitle||"").trim().toLowerCase();
