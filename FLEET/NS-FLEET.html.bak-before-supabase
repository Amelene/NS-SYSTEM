      '<div class="i"><span>Report type</span><b>'+esc(r.reportType||"—")+'</b></div>'+
      '<div class="i"><span>Vessel</span><b>'+esc(vesselName(r.vessel))+'</b></div>'+
      '<div class="i"><span>Voyage</span><b>'+esc(r.voyage||"—")+'</b></div>'+
      '<div class="i"><span>Total hours run</span><b>'+qty(c.hours,1)+'</b></div>'+
      '<div class="i"><span>Fuel ROB at end of day</span><b>'+(r.robEnd?qty(r.robEnd)+" L":"—")+'</b></div>'+
      '</div>';
    h+='<div class="fsec" style="margin:12px 0 8px">Engine breakdown</div><div class="tw"><table class="grid"><thead><tr>'+
      '<th>Engine</th><th>Sea hrs</th><th>Port hrs</th><th>Rate sea</th><th>Rate port</th><th>Expected</th><th>Reported</th><th>Variance</th></tr></thead><tbody>';
    c.rows.forEach(function(x){
      h+='<tr><td><b>'+esc(x.tag)+'</b></td><td>'+qty(x.sea,1)+'</td><td>'+qty(x.port,1)+'</td>'+
         '<td>'+qty(x.rateSea,1)+'</td><td>'+qty(x.ratePort,1)+'</td><td>'+qty(x.expected)+'</td><td><b>'+qty(x.used)+'</b></td>'+
         '<td>'+(x.pct===null?'—':pill((x.pct>0?"+":"")+x.pct.toFixed(1)+"%", x.state==="off"?"bad":(Math.abs(x.pct)>5?"warn":"ok")))+'</td></tr>';
    });
    h+='<tr style="background:#eaf1f4;font-weight:700"><td colspan="5" style="text-align:right">Total</td><td>'+qty(c.expected)+'</td><td>'+qty(c.used)+'</td><td>'+FuelLog.variancePill(c)+'</td></tr>';
    h+='</tbody></table></div>';
    var b=FuelLog.balance(r);
    h+='<div class="fsec" style="margin:14px 0 8px">Fuel remaining on board</div><div class="tw"><table class="grid" style="min-width:420px"><tbody>'+
      '<tr><td>Opening ROB'+(b.source?' <span style="color:#5d7480;font-size:12px">('+esc(b.source)+')</span>':'')+'</td><td style="text-align:right">'+(b.opening===null?"—":qty(b.opening)+" L")+'</td></tr>'+
      '<tr><td>Plus bunkers received'+(b.bunkerings?' ('+b.bunkerings+')':'')+'</td><td style="text-align:right">'+(b.received?"+"+qty(b.received)+" L":"0 L")+'</td></tr>'+
      '<tr><td>Less fuel consumed'+((c.usedMain&&c.usedAux)?' <span style="color:#5d7480;font-size:12px">(main '+qty(c.usedMain)+' L + auxiliary '+qty(c.usedAux)+' L)</span>':'')+'</td><td style="text-align:right">'+(b.consumed?"\u2212"+qty(b.consumed)+" L":"0 L")+'</td></tr>'+
      '<tr style="background:#eaf1f4;font-weight:700"><td>Calculated ROB</td><td style="text-align:right">'+(b.calculated===null?"—":qty(b.calculated)+" L")+'</td></tr>'+
      '<tr><td>ROB by sounding</td><td style="text-align:right">'+(b.sounded===null?"not taken":qty(b.sounded)+" L")+'</td></tr>'+
      '<tr><td>Difference</td><td style="text-align:right">'+FuelLog.robPill(b)+'</td></tr></tbody></table></div>';
    if(r.remarks) h+='<div class="fsec" style="margin:12px 0 6px">Remarks</div><p style="font-size:13.5px;margin:0">'+esc(r.remarks)+'</p>';
    UI.open("Daily fuel entry", h,
      '<button class="btn g" onclick="UI.close()">Close</button><button class="btn" onclick="UI.close();FuelLog.form(\''+id+'\')">Edit</button>',"lg");
  },

  flagged:function(){
    return (DB.fuellog||[]).filter(function(r){ return FuelLog.calc(r).flags>0; });
  },

  varianceView:function(){
    var logs=(DB.fuellog||[]);
    if(!logs.length) return '<div class="card"><div class="empty"><b>No daily entries yet</b>Encode daily consumption to build the variance report.</div></div>';
    var flagged=FuelLog.flagged();
    var tot={used:0,exp:0,hrs:0};
    logs.forEach(function(r){ var c=FuelLog.calc(r); tot.used+=c.used; tot.exp+=c.expected; tot.hrs+=c.hours; });
    var pct = tot.exp>0? ((tot.used-tot.exp)/tot.exp)*100 : 0;
    var h='<div class="kpis">'+
      '<div class="kpi money"><div class="n">'+qty(tot.used)+' L</div><div class="l">Reported consumption</div></div>'+
      '<div class="kpi money"><div class="n">'+qty(tot.exp)+' L</div><div class="l">Expected at declared rates</div></div>'+
      '<div class="kpi money '+(Math.abs(pct)>10?"danger":"")+'"><div class="n">'+(pct>0?"+":"")+pct.toFixed(1)+'%</div><div class="l">Fleet variance</div></div>'+
      kpi(flagged.length,"Entries out of range",flagged.length?"danger":"")+
      '</div>';
    /* per vessel per engine */
    var byE={};
    logs.forEach(function(r){
      var c=FuelLog.calc(r);
      c.rows.forEach(function(x){
        var k=r.vessel+"|"+x.unit;
        var o=byE[k]=byE[k]||{v:vesselName(r.vessel),tag:x.tag,used:0,exp:0,hrs:0,n:0,off:0};
        o.used+=x.used; o.exp+=x.expected; o.hrs+=x.hours; o.n++; if(x.state==="off") o.off++;
      });
    });
    var rows=Object.keys(byE).sort().map(function(k){
      var o=byE[k];
      var p = o.exp>0? ((o.used-o.exp)/o.exp)*100 : null;
      return [o.v,'<b>'+o.tag+'</b>',String(o.n),qty(o.hrs,1),qty(o.exp),qty(o.used),
              p===null?"—":pill((p>0?"+":"")+p.toFixed(1)+"%", Math.abs(p)>10?"bad":(Math.abs(p)>5?"warn":"ok")),
              o.off?pill(o.off+" flagged","bad"):"0",
              o.hrs?qty(o.used/o.hrs,1)+" L/h":"—"];
    });
    h+=tableCard("Variance by engine",["Vessel","Engine","Entries","Hours run","Expected (L)","Reported (L)","Variance","Out of range","Actual rate"],rows,
      '<button class="btn sm g" onclick="FuelLog.printVariance()">Print</button>');
    if(flagged.length){
      var fr=sortBy(flagged,"date",true).map(function(r){
        var c=FuelLog.calc(r);
        var worst=c.rows.filter(function(x){return x.state==="off";}).map(function(x){return x.tag+" "+(x.pct>0?"+":"")+x.pct.toFixed(1)+"%";}).join(", ");
        return [esc(r.refNo||""),esc(dmy(r.date)),esc(vesselName(r.vessel)),esc(worst),qty(c.expected),qty(c.used),
                '<button class="btn sm g" onclick="FuelLog.detail(\''+r.id+'\')">Open</button>'];
      });
      h+=tableCard("Entries needing verification",["Ref.","Date","Vessel","Engine variance","Expected (L)","Reported (L)",""],fr);
    }
    return h;
  },

  printVariance:function(){
    var logs=sortBy(DB.fuellog||[],"date",true);
    if(!logs.length) return UI.alert("No daily entries recorded yet.");
    var rows=logs.map(function(r){
      var c=FuelLog.calc(r), b=FuelLog.balance(r);
