/* =====================================================================
   VOYAGE — elapsed time, steaming time, distance and speed
   ATD and ATA give the elapsed time. Less any stoppage, that is the
   steaming time. Distance and speed derive from each other: whichever
   the user is typing into drives the other.
   ===================================================================== */
var Voyage={
  _driver:"distance",
  driver:function(which){ Voyage._driver=which; },

  when:function(dateId,timeId){
    var d=(document.getElementById(dateId)||{value:""}).value;
    if(!d) return null;
    var t=hhmm((document.getElementById(timeId)||{value:""}).value)||"0000";
    var dt=new Date(d+"T"+t.slice(0,2)+":"+t.slice(2)+":00");
    return isNaN(dt)? null : dt;
  },

  calc:function(which){
    if(which) Voyage._driver=which;
    var el=function(i){ return document.getElementById(i); };
    var fElapsed=el("fld_elapsed"), fSteam=el("fld_steamHours"), fNote=el("fld_passageNote");
    if(!fElapsed||!fSteam) return;
    var a=Voyage.when("fld_atd","fld_atdTime"), b=Voyage.when("fld_ata","fld_ataTime");
    var elapsed=null, note="";
    if(a&&b){
      elapsed=(b-a)/3600000;
      if(elapsed<0){ note="Arrival is before departure — check the dates and times."; elapsed=null; }
    } else note="Enter both ATD and ATA to work out the passage.";
    fElapsed.value = elapsed===null? "" : elapsed.toFixed(2);

    var stop=num((el("fld_stopHours")||{value:""}).value);
    var steam = elapsed===null? null : Math.max(0, elapsed-stop);
    if(elapsed!==null && stop>elapsed) note="Stoppage is longer than the elapsed time — check the figures.";
    fSteam.value = steam===null? "" : steam.toFixed(2);

    var fd=el("fld_distance"), fs=el("fld_speed");
    if(fd&&fs&&steam!==null&&steam>0){
      if(Voyage._driver==="speed" && num(fs.value)>0){
        fd.value=(num(fs.value)*steam).toFixed(1);
      } else if(num(fd.value)>0){
        fs.value=(num(fd.value)/steam).toFixed(2);
      }
      var sp=num(fs.value);
      if(sp>0 && !note){
        note = qty(num(fd.value),1)+" NM in "+steam.toFixed(2)+" hrs at "+sp.toFixed(2)+" knots";
        if(sp>30) note+=" — check, that speed looks high";
      }
    }
    if(fNote) fNote.value=note;
  }
};

/* =====================================================================
   AUDIT — when the next one falls due
   The interval runs from the date of the audit. Only the most recent
   audit of each type, for each vessel or the office, can fall due.
   ===================================================================== */
var Audit={
  _manual:false,
  touch:function(){ Audit._manual=true; },

  open:function(){
    var nd=document.getElementById("fld_nextDue");
    Audit._manual = !!(nd && String(nd.value||"").trim()!=="");
    Audit.calc();
  },

  calc:function(){
    var nd=document.getElementById("fld_nextDue"); if(!nd||Audit._manual) return;
    var d=(document.getElementById("fld_date")||{value:""}).value;
    var m=num((document.getElementById("fld_intervalMonths")||{value:""}).value);
    if(!d||m<=0){ nd.value=""; return; }
    var dt=new Date(d+"T00:00:00");
    if(isNaN(dt)){ nd.value=""; return; }
    var day=dt.getDate();
    dt.setMonth(dt.getMonth()+Math.round(m));
    /* 31 January plus a month must not roll into March */
    if(dt.getDate()<day) dt.setDate(0);
    nd.value=dt.toISOString().slice(0,10);
  },

  /* the latest audit of each type for each vessel or the office */
  latest:function(){
    var byKey={};
    (DB.audits||[]).forEach(function(a){
      if(!a.nextDue) return;
      var k=(a.type||"")+"|"+(a.vessel||"office");
      if(!byKey[k] || String(a.date)>String(byKey[k].date)) byKey[k]=a;
    });
    return Object.keys(byKey).map(function(k){ return byKey[k]; });
  },

  dueList:function(){
    return Audit.latest().filter(function(a){ return days(a.nextDue)<=60; })
      .sort(function(x,y){ return days(x.nextDue)-days(y.nextDue); });
  }
};

