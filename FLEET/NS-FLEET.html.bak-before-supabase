function expiryPill(dateStr, warnDays, badLabel, warnLabel){
  if(!dateStr) return pill("Not set","neu");
  var d=days(dateStr);
  if(d<0) return pill((badLabel||"Expired")+" "+Math.abs(d)+"d","bad");
  if(d<=(warnDays||30)) return pill((warnLabel||"Expires")+" in "+d+"d","warn");
  return pill(d+" days left","ok");
}

