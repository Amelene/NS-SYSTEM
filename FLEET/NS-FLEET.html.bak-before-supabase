function norm(s){ return String(s||"").toLowerCase().replace(/[^a-z0-9]/g,""); }
function pick(obj,keys){
  for(var k in obj){ var n=norm(k); for(var i=0;i<keys.length;i++){ if(n===keys[i]) return obj[k]; } }
  for(var k2 in obj){ var n2=norm(k2); for(var j=0;j<keys.length;j++){ if(n2.indexOf(keys[j])>=0) return obj[k2]; } }
  return "";
}
function dateish(v){
  if(!v) return "";
  var s=String(v).trim();
  if(/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0,10);
  var m=s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if(m) return m[3]+"-"+String(m[2]).padStart(2,"0")+"-"+String(m[1]).padStart(2,"0");
  var d=new Date(s); if(!isNaN(d)) return d.toISOString().slice(0,10);
  return "";
}
function findArray(d){
  if(Array.isArray(d)&&d.length&&typeof d[0]==="object") return d;
  var best=[];
  for(var k in d){
    var v=d[k];
    if(Array.isArray(v)&&v.length&&typeof v[0]==="object"){
      if(/crew|roster|seafarer|personnel/i.test(k)) return v;
      if(v.length>best.length) best=v;
    }
  }
  return best;
}
function parseCSV(text){
  var lines=text.replace(/\r/g,"").split("\n").filter(function(l){return l.trim();});
  if(lines.length<2) return [];
  function split(l){
    var out=[],cur="",q=false;
    for(var i=0;i<l.length;i++){
      var c=l[i];
      if(q){ if(c==='"'){ if(l[i+1]==='"'){cur+='"';i++;} else q=false; } else cur+=c; }
      else { if(c==='"') q=true; else if(c===","){ out.push(cur); cur=""; } else cur+=c; }
    }
    out.push(cur); return out;
  }
  var head=split(lines[0]);
  return lines.slice(1).map(function(l){
    var cells=split(l), o={};
    head.forEach(function(h,i){ o[h.trim()]=(cells[i]||"").trim(); });
    return o;
  });
}

