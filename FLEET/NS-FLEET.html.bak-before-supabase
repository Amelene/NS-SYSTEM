        REPORT_TYPES.map(function(o){return '<option'+((rec&&rec.reportType===o)||(!rec&&o==="Noon at sea")?" selected":"")+'>'+esc(o)+'</option>';}).join("")+'</select></div>'+
      '<div class="f"><label>Vessel <span class="req">*</span></label><select id="fl_vessel" onchange="FuelLog.buildRows(this.value)">'+
        vesselOpts().map(function(o){return '<option value="'+o.v+'"'+(vid===o.v?" selected":"")+'>'+esc(o.l)+'</option>';}).join("")+'</select></div>'+
      '<div class="f"><label>Date <span class="req">*</span></label><input type="date" id="fl_date" value="'+esc(rec?rec.date:today())+'" onchange="FuelLog.live()"></div>'+
      '<div class="f"><label>Time <span class="req">*</span></label>'+
        '<input type="text" inputmode="numeric" maxlength="5" placeholder="1200" id="fl_time" value="'+esc(rec?(hhmm(rec.time)||"1200"):"1200")+'" onblur="this.value=hhmm(this.value)||\'1200\';FuelLog.live()" oninput="FuelLog.live()">'+
        '<div class="hint">Ship&rsquo;s time, 24-hour (e.g. 0800, 1200, 1800). Only bunkering taken after the previous report and up to this time is added here.</div></div>'+
      '<div class="f"><label>Voyage no.</label><input type="text" id="fl_voyage" value="'+esc(rec?rec.voyage||"":"")+'"></div>'+
      '<div class="f"><label>Opening ROB (litres)</label><input type="number" step="any" inputmode="decimal" id="fl_open" value="'+esc(rec?rec.openingROB||"":"")+'" oninput="FuelLog.openTouched()">'+
        '<div class="hint" id="fl_openinfo"></div></div>'+
      '<div class="f"><label>ROB by sounding at end of day (litres)</label><input type="number" step="any" inputmode="decimal" id="fl_rob" value="'+esc(rec?rec.robEnd||"":"")+'" oninput="FuelLog.live()">'+
        '<div class="hint">The Master&rsquo;s actual sounding. Leave blank if not taken.</div></div>'+
      '</div>'+
      '<div class="fsec" style="margin:12px 0 8px">Consumption by engine</div>'+
      '<div id="fl_rows"></div>'+
      '<div class="fsec" style="margin:14px 0 8px">Fuel remaining on board</div>'+
      '<div id="fl_rob_block"></div>'+
      '<div class="f full" style="margin-top:12px"><label>Master&rsquo;s remarks</label><textarea id="fl_remarks">'+esc(rec?rec.remarks||"":"")+'</textarea></div>';
    FuelLog._editing = id||null;
    FuelLog._openManual = !!(rec && String(rec.openingROB||"").trim()!=="");
    UI.open((rec?"Edit ":"Add ")+"daily fuel entry", h,
      '<button class="btn g" onclick="UI.close()">Cancel</button><button class="btn o" onclick="FuelLog.save('+(id?"'"+id+"'":"null")+')">Save entry</button>',"lg");
    FuelLog.buildRows(vid, rec);
  },

  buildRows:function(vid, rec){
    if(!rec) FuelLog._openManual=false;
    var box=document.getElementById("fl_rows");
    var eng=enginesFor(vid);
    if(!eng.length){
      box.innerHTML='<div class="empty" style="background:#fbfdfe;border:1px dashed #d7e1e6;border-radius:6px">'+
        '<b>No engines registered for this vessel</b>Add the main and auxiliary engines with their declared consumption rates, then come back to encode daily figures.'+
        '<div style="margin-top:10px"><button class="btn o" onclick="UI.close();App.go(\'fuel\',\'engines\')">Go to the engine register</button></div></div>';
      return;
    }
    var h='<div class="tw"><table class="grid"><thead><tr><th>Engine</th><th>Declared at sea</th><th>Declared in port</th>'+
      '<th>Hours at sea</th><th>Hours in port</th><th>Fuel reported (L)</th><th>Expected (L)</th><th>Variance</th></tr></thead><tbody>';
    eng.forEach(function(e,i){
      var prev = rec && (rec.rows||[]).filter(function(x){return x.unit===e.unit;})[0];
      h+='<tr><td><b>'+esc(shortTag(e.unit))+'</b><br><span style="font-size:11px;color:#5d7480">'+esc(e.maker||"")+'</span></td>'+
        '<td>'+qty(e.rateSea,1)+' L/h</td><td>'+qty(e.ratePort,1)+' L/h</td>'+
        '<td><input type="number" step="any" inputmode="decimal" style="width:82px;padding:6px;border:1px solid #d7e1e6;border-radius:5px" id="fr_sea_'+i+'" value="'+esc(prev?prev.seaHrs:"")+'" oninput="FuelLog.live()"></td>'+
        '<td><input type="number" step="any" inputmode="decimal" style="width:82px;padding:6px;border:1px solid #d7e1e6;border-radius:5px" id="fr_port_'+i+'" value="'+esc(prev?prev.portHrs:"")+'" oninput="FuelLog.live()"></td>'+
        '<td><input type="number" step="any" inputmode="decimal" style="width:96px;padding:6px;border:1px solid #d7e1e6;border-radius:5px" id="fr_used_'+i+'" value="'+esc(prev?prev.used:"")+'" oninput="FuelLog.live()"></td>'+
        '<td id="fr_exp_'+i+'" style="font-weight:600">—</td><td id="fr_var_'+i+'">—</td>'+
        '<input type="hidden" id="fr_unit_'+i+'" value="'+esc(e.unit)+'"></tr>';
    });
    h+='</tbody><tfoot><tr style="background:#eaf1f4;font-weight:700"><td colspan="5" style="text-align:right">Total consumed (deducted from ROB)</td>'+
       '<td id="fr_tused">—</td><td id="fr_texp">—</td><td id="fr_tvar">—</td></tr></tfoot></table></div>'+
       '<div id="fr_warn" style="margin-top:10px"></div>';
    box.innerHTML=h;
    FuelLog.live();
  },

  read:function(){
    var vid=document.getElementById("fl_vessel").value;
    var eng=enginesFor(vid), rows=[];
    eng.forEach(function(e,i){
      var u=document.getElementById("fr_unit_"+i); if(!u) return;
      rows.push({unit:u.value,
        seaHrs:document.getElementById("fr_sea_"+i).value,
        portHrs:document.getElementById("fr_port_"+i).value,
        used:document.getElementById("fr_used_"+i).value});
    });
    var el=function(i){ var e=document.getElementById(i); return e?e.value:""; };
    var cur=FuelLog._editing? byId(DB.fuellog,FuelLog._editing) : null;
    return {vessel:vid, rows:rows, date:el("fl_date"), time:el("fl_time"), openingROB:el("fl_open"), robEnd:el("fl_rob"),
            id:FuelLog._editing||null, created:cur?cur.created:null};
  },

  live:function(){
    var d=FuelLog.read(), c=FuelLog.calc(d);
    c.rows.forEach(function(r,i){
      var ex=document.getElementById("fr_exp_"+i), va=document.getElementById("fr_var_"+i);
      if(!ex) return;
      ex.textContent = r.expected>0? qty(r.expected)+" L" : "—";
      if(r.state==="off") va.innerHTML=pill((r.pct>0?"+":"")+r.pct.toFixed(1)+"% \u2014 check","bad");
      else if(r.state==="nostandard") va.innerHTML=pill("No rate set","warn");
      else if(r.pct===null) va.innerHTML='<span style="color:#9db3bd">—</span>';
      else va.innerHTML=pill((r.pct>0?"+":"")+r.pct.toFixed(1)+"%", Math.abs(r.pct)>5?"warn":"ok");
    });
    var tu=document.getElementById("fr_tused"); if(!tu) return;
    tu.textContent=qty(c.used)+" L";
    document.getElementById("fr_texp").textContent=qty(c.expected)+" L";
    document.getElementById("fr_tvar").innerHTML=FuelLog.variancePill(c);
    FuelLog.syncOpening();
    d.openingROB=(document.getElementById("fl_open")||{value:""}).value;
    FuelLog.liveROB(d);
    var w=document.getElementById("fr_warn");
    if(c.flags){
      var lines=c.rows.filter(function(r){return r.state==="off";}).map(function(r){
        return '<li><b>'+esc(r.tag)+'</b>: reported '+qty(r.used)+' L against an expected '+qty(r.expected)+' L for '+qty(r.hours,1)+
               ' hours run — '+(r.pct>0?"over":"under")+' by '+Math.abs(r.pct).toFixed(1)+'% (tolerance &plusmn;'+r.tol+'%)</li>';
      }).join("");
      w.innerHTML='<div style="background:#fbe4e2;border:1px solid #f0bdb8;border-radius:6px;padding:10px 12px;font-size:13px;color:#7a1a15">'+
        '<b>Out of range — check the figures before saving</b><ul style="margin:6px 0 0;padding-left:18px">'+lines+'</ul>'+
        '<div style="margin-top:6px;font-size:12.5px">If the figures are correct, save anyway and note the reason in the remarks. The entry will stay flagged on the dashboard.</div></div>';
    } else w.innerHTML="";
  },

  openTouched:function(){ FuelLog._openManual=true; FuelLog.live(); },

  /* fill the opening figure from the previous report unless the user typed over it */
  syncOpening:function(){
    var fo=document.getElementById("fl_open"); if(!fo) return null;
    var vid=document.getElementById("fl_vessel").value;
    var date=document.getElementById("fl_date").value;
    var cur=FuelLog._editing? byId(DB.fuellog,FuelLog._editing) : null;
    var tm=(document.getElementById("fl_time")||{value:""}).value;
    var c=FuelLog.carried(vid,date,FuelLog._editing||null,cur?cur.created:null,tm);
    if(!FuelLog._openManual){
      fo.value = (c && c.value!==null)? c.value : "";
    }
    return c;
  },

  liveROB:function(d){
    var box=document.getElementById("fl_rob_block"); if(!box) return;
    var b=FuelLog.balance(d);
    var info=document.getElementById("fl_openinfo");
    if(info){
      var c=FuelLog.carried(d.vessel,d.date,FuelLog._editing||null,d.created,d.time);
      if(FuelLog._openManual && c && c.value!==null && Math.abs(num(d.openingROB)-c.value)>0.001)
        info.innerHTML='<span style="color:#b6801a">Entered manually. The previous report ('+esc(dmy(c.date))+') closed at <b>'+qty(c.value)+' L</b> — '+
          '<a href="#" onclick="FuelLog.resetOpening();return false;">use that figure</a>.</span>';
      else if(c && c.value!==null)
        info.innerHTML='Linked to '+esc(c.ref?c.ref+" · ":"")+esc(c.type?c.type.split(" — ")[0]+" · ":"")+esc(dmy(c.date))+esc(c.time?" "+hhmm(c.time):"")+' — closing ROB <b>'+qty(c.value)+' L</b>';
      else{
        var sd=FuelLog.seedFromBunker(d.vessel,d.date);
        if(sd) info.innerHTML='First report for this vessel. Last recorded figure was <b>'+qty(sd.value)+' L</b> after '+esc(sd.ref||"bunkering")+' on '+esc(dmy(sd.date))+' — '+
          '<a href="#" onclick="FuelLog.useSeed('+sd.value+');return false;">use that figure</a>.';
        else info.textContent="First report for this vessel — enter the opening ROB to start the running balance.";
      }
    }
    var cc=FuelLog.calc(d);
    var consumedNote = (cc.usedMain&&cc.usedAux)
      ? ' <span style="color:#5d7480;font-size:12px">(main '+qty(cc.usedMain)+' L + auxiliary '+qty(cc.usedAux)+' L)</span>' : '';
    var bl=b.list||[];
    var bunkerLine = bl.length
      ? bl.map(function(x){ return esc(x.refNo||"")+" \u00B7 "+esc(dmy(x.date))+(x.time?" "+esc(hhmm(x.time)):"")+" \u00B7 "+qty(x.litres)+" L "+esc(x.grade||"")+(x.bdn?" \u00B7 BDN "+esc(x.bdn):"")+(x.port?" \u00B7 "+esc(x.port):""); }).join("<br>")
      : '<span style="color:#5d7480">No bunkering falls between the previous report and this one.</span>';
    var rowsHTML=
      '<div class="tw"><table class="grid" style="min-width:420px"><tbody>'+
      '<tr><td>Opening ROB</td><td style="text-align:right">'+(b.opening===null?"—":qty(b.opening)+" L")+'</td></tr>'+
      '<tr><td>Plus bunkers received today'+(b.bunkerings?' <span class="pill p-info">'+b.bunkerings+'</span>':'')+'</td><td style="text-align:right;color:#1a7f4b">'+(b.received?"+"+qty(b.received)+" L":"0 L")+'</td></tr>'+
      '<tr><td>Less fuel consumed'+consumedNote+'</td><td style="text-align:right;color:#b3261e">'+(b.consumed?"\u2212"+qty(b.consumed)+" L":"0 L")+'</td></tr>'+
      '<tr style="background:#eaf1f4;font-weight:700"><td>Calculated ROB</td><td style="text-align:right">'+(b.calculated===null?"—":qty(b.calculated)+" L")+'</td></tr>'+
      '<tr><td>ROB by sounding</td><td style="text-align:right">'+(b.sounded===null?"not taken":qty(b.sounded)+" L")+'</td></tr>'+
      '<tr><td>Difference</td><td style="text-align:right">'+FuelLog.robPill(b)+'</td></tr>'+
      '</tbody></table></div>'+
      '<div style="margin-top:8px;font-size:12.5px;color:#5d7480"><b>Bunkering picked up by this report:</b><br>'+bunkerLine+
      ' <button type="button" class="btn sm g" style="margin-top:6px" onclick="FuelLog.addBunkerFrom()">Record a bunkering</button></div>';
    if(b.flag){
      rowsHTML+='<div style="background:#fbe4e2;border:1px solid #f0bdb8;border-radius:6px;padding:10px 12px;font-size:13px;color:#7a1a15;margin-top:10px">'+
        '<b>ROB does not balance</b><br>The sounding differs from the calculated figure by '+qty(Math.abs(b.diff))+' L, beyond the '+qty(b.allow)+' L allowance. '+
        'Check for an unrecorded bunkering, a missed daily entry, or a sounding error before saving.</div>';
    }
    box.innerHTML=rowsHTML;
  },

  resetOpening:function(){ FuelLog._openManual=false; FuelLog.live(); },
  useSeed:function(v){ var f=document.getElementById("fl_open"); if(f){ f.value=v; FuelLog._openManual=true; FuelLog.live(); } },

  addBunkerFrom:function(){
    UI.confirm("Leave this entry and open the bunkering register? Anything not yet saved here will be lost.").then(function(ok){
      if(!ok) return;
      App.go("fuel","bunkers");
      setTimeout(function(){ Register.form("bunkers"); },120);
    });
  },

  save:function(id){
    var d=FuelLog.read();
    var date=document.getElementById("fl_date").value;
    if(!d.vessel||!date) return UI.alert("Vessel and date are both required.");
    if(!d.rows.length) return UI.alert("This vessel has no engines registered. Add them in the engine register first.");
    var any=d.rows.some(function(r){ return num(r.used)>0||num(r.seaHrs)>0||num(r.portHrs)>0; });
    if(!any) return UI.alert("Enter the hours run and fuel consumed for at least one engine.");
    var rec = id? byId(DB.fuellog,id) : {id:uid(),created:new Date().toISOString()};
    if(!rec.created) rec.created=new Date().toISOString();
    rec.vessel=d.vessel; rec.date=date; rec.rows=d.rows;
    rec.time=hhmm(document.getElementById("fl_time").value)||"1200";
    rec.reportType=document.getElementById("fl_type").value;
    rec.voyage=document.getElementById("fl_voyage").value;
    var openVal=document.getElementById("fl_open").value;
    var carried=FuelLog.carried(d.vessel,date,id||null,rec.created,rec.time);
    /* store the figure only when it differs from the carried one, so a later
       correction to an earlier report still flows through to this entry */
    rec.openingROB = (carried && carried.value!==null && String(openVal).trim()!=="" &&
                      Math.abs(num(openVal)-carried.value)<0.001) ? "" : openVal;
    rec.robEnd=document.getElementById("fl_rob").value;
    rec.remarks=document.getElementById("fl_remarks").value;
    rec.updated=new Date().toISOString();
    if(!id){ rec.refNo=seq("fuellog","FL-",5); DB.fuellog.push(rec); }
    save(); FuelLog._editing=null; UI.close(); App.render();
    var c=FuelLog.calc(rec), b=FuelLog.balance(rec);
    UI.toast(c.flags? "Saved — consumption flagged as out of range"
           : (b.flag? "Saved — ROB does not balance" : "Daily entry saved"));
  },

  del:function(id){
    var r=byId(DB.fuellog,id);
    UI.confirm("Delete daily entry "+(r.refNo||"")+" for "+vesselName(r.vessel)+"? This cannot be undone.").then(function(ok){
      if(!ok) return;
      DB.fuellog=DB.fuellog.filter(function(x){return x.id!==id;});
      save(); App.render(); UI.toast("Entry deleted");
    });
  },

