/* =====================================================================
   FUEL — engine register, daily consumption entry and variance check
   Expected fuel = (hours at sea x rate at sea) + (hours in port x rate in port)
   per engine. Reported against expected, flagged outside the tolerance.
   ===================================================================== */

function shortTag(unit){
  if(!unit) return "";
  if(ENGINE_TAGS[unit]) return ENGINE_TAGS[unit];
  var m=String(unit).match(/No\.(\d)/), side=/\(P\)/.test(unit)?" (P)":(/\(S\)/.test(unit)?" (S)":"");
  return (/Main/i.test(unit)?"ME":"AE")+(m?m[1]:"")+side;
}
function enginesFor(vid){
  return (DB.engines||[]).filter(function(e){return e.vessel===vid;})
    .sort(function(a,b){
      var ia=ENGINE_UNITS.indexOf(a.unit), ib=ENGINE_UNITS.indexOf(b.unit);
      if(ia<0) ia=99; if(ib<0) ib=99;
      return ia-ib || String(a.unit).localeCompare(String(b.unit));
    });
}
function findEngine(vid,unit){
  var l=(DB.engines||[]).filter(function(e){return e.vessel===vid&&e.unit===unit;});
  return l.length?l[0]:null;
}

/* fuel grades only — lube, hydraulic oil and grease do not move the fuel ROB */
function isFuelGrade(g){ return /diesel|gas oil/i.test(String(g||"")); }

var FuelLog={

  /* a report is stamped at its own date and time; an untimed one closes the day.
     a bunkering with no time is treated as start of day, so older records behave
     exactly as they did before times were recorded.                              */
  stamp:function(rec){ return String(rec.date||"")+"T"+(hhmm(rec.time)||"2359"); },
  bunkerStamp:function(b){ return String(b.date||"")+"T"+(hhmm(b.time)||"0000"); },

  /* bunkers taken between the previous report and this one */
  receivedFor:function(rec){
    var to=FuelLog.stamp(rec);
    var prev=FuelLog.prevEntry(rec);
    var from = prev? FuelLog.stamp(prev) : String(rec.date||"")+"T00:00";
    return (DB.bunkers||[]).filter(function(b){
      if(b.vessel!==rec.vessel || !isFuelGrade(b.grade)) return false;
      var st=FuelLog.bunkerStamp(b);
      return prev? (st>from && st<=to) : (st>=from && st<=to);
    }).sort(function(a,b2){ return FuelLog.bunkerStamp(a)<FuelLog.bunkerStamp(b2)?-1:1; });
  },

  /* the report immediately before this one for the same vessel */
  prevEntry:function(rec){
    return FuelLog.previous(rec.vessel, FuelLog.key(rec), rec.id);
  },

  /* entries are chained by date, then by the order they were created on that date,
     so several reports on one day (departure, noon, arrival) follow each other       */
  key:function(rec){
    return FuelLog.stamp(rec)+"|"+String(rec.created||"\uffff");
  },
  previous:function(vid,key,excludeId){
    var list=(DB.fuellog||[]).filter(function(x){
      return x.vessel===vid && x.id!==excludeId && FuelLog.key(x)<key;
    });
    if(!list.length) return null;
    list.sort(function(a,b){ var ka=FuelLog.key(a), kb=FuelLog.key(b); return ka<kb?1:(ka>kb?-1:0); });
    return list[0];
  },

  /* the closing ROB of the previous report for this vessel — what this entry opens with */
  carried:function(vid,date,excludeId,created,time){
    var p=FuelLog.previous(vid, FuelLog.key({date:date,time:time,created:created}), excludeId);
    if(!p) return null;
    return {value:FuelLog.closing(p,0), date:p.date, time:p.time||"", ref:p.refNo||"", type:p.reportType||""};
  },

  /* last bunkering before this date that recorded a ROB — offered as a starting figure */
  seedFromBunker:function(vid,date){
    var l=(DB.bunkers||[]).filter(function(b){
      return b.vessel===vid && isFuelGrade(b.grade) && String(b.robAfter||"").trim()!=="" && String(b.date)<=String(date);
    });
    if(!l.length) return null;
    var b=sortBy(l,"date",true)[0];
    return {value:num(b.robAfter), date:b.date, ref:b.refNo||""};
  },

  /* closing ROB of an entry: the sounding if the Master gave one, else the calculated figure */
  closing:function(rec,depth){
    if(!rec||(depth||0)>60) return null;
    if(String(rec.robEnd||"").trim()!=="") return num(rec.robEnd);
    var b=FuelLog.balance(rec,(depth||0)+1);
    return b.calculated;
  },

  /* opening + received - consumed = calculated, against the sounding */
  balance:function(rec,depth){
    var consumed=FuelLog.calc(rec).used;
    var list=FuelLog.receivedFor(rec);
    var recv=list.reduce(function(t,b){return t+num(b.litres);},0);
    var opening=null, source="";
    if(String(rec.openingROB||"").trim()!==""){ opening=num(rec.openingROB); source="entered"; }
    else{
      var p=FuelLog.prevEntry(rec);
      if(p){ opening=FuelLog.closing(p,(depth||0)+1); source="carried forward from "+(p.refNo?p.refNo+" · ":"")+dmy(p.date)+(p.time?" "+hhmm(p.time):""); }
    }
    var calculated = opening===null? null : opening+recv-consumed;
    var sounded = String(rec.robEnd||"").trim()===""? null : num(rec.robEnd);
    var diff = (calculated===null||sounded===null)? null : sounded-calculated;
    /* allow the greater of 50 litres or 2% of the calculated figure for sounding error */
    var allow = calculated===null? 0 : Math.max(50, Math.abs(calculated)*0.02);
    return {opening:opening,source:source,received:recv,list:list,bunkerings:list.length,
            consumed:consumed,calculated:calculated,sounded:sounded,diff:diff,allow:allow,
            flag:(diff!==null && Math.abs(diff)>allow)};
  },

  robPill:function(b){
    if(b.diff===null) return pill("—","neu");
    var v=(b.diff>0?"+":"")+qty(b.diff)+" L";
    return b.flag? pill(v+" — check","bad") : pill(v,"ok");
  },

  /* ---- compute one record ---- */
  calc:function(rec){
    var out={rows:[],used:0,expected:0,hours:0,flags:0,worst:0,noStandard:0,usedMain:0,usedAux:0,hoursMain:0,hoursAux:0};
    (rec.rows||[]).forEach(function(r){
      var e=findEngine(rec.vessel,r.unit);
      var rs=e?num(e.rateSea):0, rp=e?num(e.ratePort):0;
      var tol=e&&e.tolerance!==""&&e.tolerance!=null? num(e.tolerance) : 10;
      var sea=num(r.seaHrs), port=num(r.portHrs), used=num(r.used);
      var exp=sea*rs+port*rp, hrs=sea+port;
      var pct = exp>0 ? ((used-exp)/exp)*100 : null;
      var state="ok";
      if(!e) state="noengine";
      else if(exp<=0 && used>0) state="nostandard";
      else if(pct===null) state="none";
      else if(Math.abs(pct)>tol) state="off";
      if(state==="off") out.flags++;
      if(state==="nostandard"||state==="noengine") out.noStandard++;
      if(pct!==null && Math.abs(pct)>Math.abs(out.worst)) out.worst=pct;
      out.rows.push({unit:r.unit,tag:shortTag(r.unit),sea:sea,port:port,used:used,
                     rateSea:rs,ratePort:rp,tol:tol,expected:exp,hours:hrs,pct:pct,state:state});
      out.used+=used; out.expected+=exp; out.hours+=hrs;
      if(/Main/i.test(r.unit)){ out.usedMain+=used; out.hoursMain+=hrs; } else { out.usedAux+=used; out.hoursAux+=hrs; }
    });
    out.pct = out.expected>0 ? ((out.used-out.expected)/out.expected)*100 : null;
    return out;
  },

  variancePill:function(c){
    if(c.noStandard && !c.flags) return pill("No standard set","neu");
    if(c.pct===null) return pill("—","neu");
    var v=(c.pct>0?"+":"")+c.pct.toFixed(1)+"%";
    if(c.flags) return pill(v+" — out of range","bad");
    if(Math.abs(c.pct)>5) return pill(v,"warn");
    return pill(v,"ok");
  },

  /* ---- list view ---- */
  view:function(){
    var rows=(DB.fuellog||[]).filter(function(r){
      if(App.filter.vessel && r.vessel!==App.filter.vessel) return false;
      if(!App.filter.q) return true;
      var q=App.filter.q.toLowerCase();
      return (vesselName(r.vessel)+" "+(r.refNo||"")+" "+(r.voyage||"")+" "+(r.remarks||"")).toLowerCase().indexOf(q)>=0;
    });
    rows.sort(function(a,b){ var ka=FuelLog.key(a), kb=FuelLog.key(b); return ka<kb?1:(ka>kb?-1:0); });
    var h='<div class="card"><h2>Daily fuel consumption<span class="r">'+
      '<button class="btn sm o" onclick="FuelLog.form()">Add daily entry</button>'+
      '<button class="btn sm g" onclick="FuelLog.csv()">Export CSV</button>'+
      '<button class="btn sm g" onclick="FuelLog.print()">Print</button></span></h2>';
    h+='<div class="toolbar">'+
      '<input type="text" class="grow" placeholder="Search entries" value="'+esc(App.filter.q)+'" oninput="App.filter.q=this.value;App.render()">'+
      '<select onchange="App.filter.vessel=this.value;App.render()"><option value="">All vessels</option>'+
      vesselOpts().map(function(o){return '<option value="'+o.v+'"'+(App.filter.vessel===o.v?" selected":"")+'>'+esc(o.l)+'</option>';}).join("")+'</select>'+
      '<span style="color:#5d7480;font-size:12.5px">'+rows.length+' entr'+(rows.length===1?"y":"ies")+'</span></div>';
    if(!rows.length){
      h+='<div class="empty"><b>No daily entries yet</b>Register the engines for each vessel first, then encode the daily figures here.</div></div>';
      return h;
    }
    h+='<div class="body tight"><div class="tw"><table class="grid"><thead><tr>'+
      '<th>Ref.</th><th>Date</th><th>Time</th><th>Report type</th><th>Vessel</th><th>Hours run</th><th>Reported (L)</th><th>Expected (L)</th><th>Variance</th><th>Bunkered (L)</th><th>ROB calculated</th><th>ROB sounded</th><th>ROB check</th><th>Actions</th></tr></thead><tbody>';
    rows.forEach(function(r){
      var c=FuelLog.calc(r), b=FuelLog.balance(r);
      h+='<tr><td>'+esc(r.refNo||"")+'</td><td>'+esc(dmy(r.date))+'</td><td>'+esc(hhmm(r.time))+'</td><td>'+(r.reportType?pill(r.reportType.split(" — ")[0],"info"):"")+'</td><td>'+esc(vesselName(r.vessel))+'</td>'+
         '<td>'+qty(c.hours,1)+'</td><td><b>'+qty(c.used)+'</b></td><td>'+qty(c.expected)+'</td>'+
         '<td>'+FuelLog.variancePill(c)+'</td>'+
         '<td>'+(b.received?qty(b.received):'<span style="color:#9db3bd">—</span>')+'</td>'+
         '<td>'+(b.calculated===null?'<span style="color:#9db3bd">—</span>':qty(b.calculated))+'</td>'+
         '<td>'+(b.sounded===null?'<span style="color:#9db3bd">—</span>':'<b>'+qty(b.sounded)+'</b>')+'</td>'+
         '<td>'+FuelLog.robPill(b)+'</td>'+
         '<td class="act"><button class="btn sm g" onclick="FuelLog.detail(\''+r.id+'\')">Open</button> '+
         '<button class="btn sm" onclick="FuelLog.form(\''+r.id+'\')">Edit</button> '+
         '<button class="btn sm d" onclick="FuelLog.del(\''+r.id+'\')">Delete</button></td></tr>';
    });
    return h+'</tbody></table></div></div></div>'+
      '<p style="font-size:12px;color:#5d7480;margin:0 2px 20px">Expected fuel is calculated per engine as hours at sea &times; rate at sea, plus hours in port &times; rate in port, using the declared rates in the engine register.</p>';
  },

  /* ---- entry form ---- */
  form:function(id){
    if(!DB.vessels.length) return UI.alert("Add a vessel first.");
