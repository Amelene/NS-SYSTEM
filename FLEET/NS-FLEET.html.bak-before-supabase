<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>NS FLEET — NAVI Shipping Fleet Management System</title>
<style>
:root{
  --navy:#0B3D56; --navy-d:#07293a; --teal:#0E6B76; --teal-l:#128795; --orange:#E1653B; --orange-d:#c4502a;
  --ink:#12222c; --muted:#5d7480; --line:#d7e1e6; --bg:#f2f6f8; --card:#ffffff;
  --ok:#1a7f4b; --warn:#b6801a; --bad:#b3261e;
  --r:8px; --sh:0 1px 3px rgba(11,61,86,.10), 0 6px 18px rgba(11,61,86,.06);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:"Segoe UI",-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--ink);font-size:15px;line-height:1.45;-webkit-text-size-adjust:100%}
button,input,select,textarea{font-family:inherit;font-size:inherit}
a{color:var(--teal)}

/* ---------- Top bar ---------- */
.topbar{background:var(--navy);color:#fff;padding:10px 14px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;position:sticky;top:0;z-index:50;box-shadow:0 2px 8px rgba(0,0,0,.18)}
.brandmark{display:flex;align-items:center;gap:10px;min-width:0}
.mono{width:60px;height:42px;border-radius:7px;background:#EAF4F3;display:flex;align-items:center;justify-content:center;flex:none;padding:3px 4px;box-shadow:inset 0 0 0 1px rgba(11,61,86,.10)}
.mono svg{width:100%;height:100%;display:block}
.ph .phmark{width:74px;margin:0 auto 2px}
.ph .phmark svg{width:100%;display:block}
.brandtext b{display:block;font-size:16px;letter-spacing:.5px;line-height:1.1}
.brandtext span{display:block;font-size:11px;opacity:.78;letter-spacing:.3px}
.topbar .spacer{flex:1}
.topbtns{display:flex;gap:6px;flex-wrap:wrap}
.tb{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:#fff;padding:6px 10px;border-radius:6px;cursor:pointer;font-size:13px}
.tb:hover{background:rgba(255,255,255,.22)}
.tb.warnbtn{background:var(--orange);border-color:var(--orange)}

/* ---------- Module nav ---------- */
.modnav{background:var(--navy-d);display:flex;gap:2px;overflow-x:auto;padding:0 6px;position:sticky;top:58px;z-index:49;-webkit-overflow-scrolling:touch}
.modnav button{background:transparent;border:0;border-bottom:3px solid transparent;color:#cfe1e8;padding:11px 13px;white-space:nowrap;cursor:pointer;font-size:13.5px}
.modnav button.on{color:#fff;border-bottom-color:var(--orange);background:rgba(255,255,255,.06)}

/* ---------- Layout ---------- */
.wrap{padding:14px;max-width:1500px;margin:0 auto}
.pagehead{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.pagehead h1{margin:0;font-size:21px;color:var(--navy);letter-spacing:.2px}
.pagehead p{margin:2px 0 0;color:var(--muted);font-size:13px}
.subnav{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.subnav button{background:#fff;border:1px solid var(--line);color:var(--navy);padding:7px 12px;border-radius:20px;cursor:pointer;font-size:13px}
.subnav button.on{background:var(--teal);border-color:var(--teal);color:#fff}

.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh);margin-bottom:14px;overflow:hidden}
.card h2{margin:0;padding:11px 14px;font-size:14.5px;color:#fff;background:var(--teal);letter-spacing:.3px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.card h2 .r{margin-left:auto;display:flex;gap:6px;flex-wrap:wrap}
.card .body{padding:14px}
.card .body.tight{padding:0}

/* ---------- Toolbar ---------- */
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:10px 14px;background:#fbfdfe;border-bottom:1px solid var(--line)}
.toolbar input[type=text],.toolbar select{padding:7px 9px;border:1px solid var(--line);border-radius:6px;background:#fff;min-width:120px}
.toolbar .grow{flex:1;min-width:150px}

/* ---------- Buttons ---------- */
.btn{background:var(--teal);color:#fff;border:0;padding:8px 13px;border-radius:6px;cursor:pointer;font-size:13.5px}
.btn:hover{background:var(--teal-l)}
.btn.o{background:var(--orange)} .btn.o:hover{background:var(--orange-d)}
.btn.g{background:#fff;color:var(--navy);border:1px solid var(--line)} .btn.g:hover{background:#eef4f7}
.btn.d{background:var(--bad)}
.btn.sm{padding:5px 9px;font-size:12.5px}
.btn:disabled{opacity:.5;cursor:not-allowed}

/* ---------- Tables ---------- */
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch}
table.grid{width:100%;border-collapse:collapse;font-size:13.2px;min-width:640px}
table.grid th{background:#eaf1f4;color:var(--navy);text-align:left;padding:9px 10px;border-bottom:2px solid var(--line);white-space:nowrap;font-weight:600;position:sticky;top:0}
table.grid td{padding:8px 10px;border-bottom:1px solid #eef3f5;vertical-align:top}
table.grid tr:nth-child(even) td{background:#fafcfd}
table.grid tr:hover td{background:#f0f7fa}
table.grid td.act{white-space:nowrap}
.empty{padding:28px 14px;text-align:center;color:var(--muted)}
.empty b{display:block;color:var(--navy);margin-bottom:4px;font-size:15px}

/* ---------- Pills / status ---------- */
.pill{display:inline-block;padding:2px 9px;border-radius:12px;font-size:11.5px;font-weight:600;white-space:nowrap}
.p-ok{background:#e3f4ea;color:var(--ok)}
.p-warn{background:#fdf3dd;color:var(--warn)}
.p-bad{background:#fbe4e2;color:var(--bad)}
.p-neu{background:#e9eff2;color:var(--muted)}
.p-info{background:#e2f0f3;color:var(--teal)}

/* ---------- KPI ---------- */
.kpis{display:grid;grid-template-columns:repeat(auto-fill,minmax(165px,1fr));gap:10px}
.kpi{background:#fff;border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:var(--r);padding:12px 13px;box-shadow:var(--sh)}
.kpi .n{font-size:25px;font-weight:700;color:var(--navy);line-height:1.1}
.kpi .l{font-size:12px;color:var(--muted);margin-top:3px}
.kpi.alert{border-left-color:var(--orange)}
.kpi.danger{border-left-color:var(--bad)}
.kpi.money .n{font-size:19px}

/* ---------- Alerts ---------- */
.alist{display:flex;flex-direction:column}
.arow{display:flex;gap:10px;align-items:flex-start;padding:10px 14px;border-bottom:1px solid #eef3f5}
.arow:last-child{border-bottom:0}
.arow .dot{width:9px;height:9px;border-radius:50%;margin-top:6px;flex:none}
.dot.bad{background:var(--bad)} .dot.warn{background:var(--warn)} .dot.info{background:var(--teal)}
.arow .t{flex:1;min-width:0}
.arow .t b{display:block;font-size:13.5px;color:var(--navy)}
.arow .t span{font-size:12.5px;color:var(--muted)}

/* ---------- Forms / modal ---------- */
.ovl{position:fixed;inset:0;background:rgba(7,41,58,.55);display:none;align-items:flex-start;justify-content:center;z-index:200;padding:18px;overflow-y:auto;-webkit-overflow-scrolling:touch}
.ovl.on{display:flex}
.modal{background:#fff;border-radius:10px;width:100%;max-width:880px;box-shadow:0 20px 60px rgba(0,0,0,.3);overflow:hidden;margin:auto}
.modal.sm{max-width:430px}
.modal.lg{max-width:1080px}
.modal header{background:var(--navy);color:#fff;padding:12px 16px;display:flex;align-items:center;gap:10px}
.modal header h3{margin:0;font-size:15.5px;font-weight:600;flex:1}
.modal header .x{background:rgba(255,255,255,.15);border:0;color:#fff;width:28px;height:28px;border-radius:6px;cursor:pointer;font-size:16px;line-height:1}
.modal .mbody{padding:16px;max-height:68vh;overflow-y:auto;-webkit-overflow-scrolling:touch}
.modal footer{padding:12px 16px;background:#f7fafb;border-top:1px solid var(--line);display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
.fgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.f{display:flex;flex-direction:column;gap:4px}
.f.full{grid-column:1/-1}
.f label{font-size:12.2px;color:var(--muted);font-weight:600}
.f label .req{color:var(--bad)}
.f input,.f select,.f textarea{padding:8px 10px;border:1px solid var(--line);border-radius:6px;background:#fff;width:100%}
.f input:focus,.f select:focus,.f textarea:focus{outline:2px solid var(--teal-l);outline-offset:0;border-color:var(--teal)}
.f textarea{min-height:66px;resize:vertical}
.f .hint{font-size:11.5px;color:var(--muted)}
.fsec{grid-column:1/-1;margin-top:4px;padding-top:8px;border-top:1px solid var(--line);color:var(--navy);font-weight:700;font-size:12.5px;letter-spacing:.4px}
.filebox{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12.5px}

/* ---------- Detail view ---------- */
.dl{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px}
.dl .i{background:#f7fafb;border:1px solid var(--line);border-radius:6px;padding:8px 10px}
.dl .i span{display:block;font-size:11.5px;color:var(--muted)}
.dl .i b{font-size:13.5px;color:var(--ink);font-weight:600;word-break:break-word}

/* ---------- Toast ---------- */
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:22px;background:var(--navy);color:#fff;padding:10px 18px;border-radius:22px;z-index:400;box-shadow:0 8px 24px rgba(0,0,0,.25);display:none;font-size:13.5px;max-width:90vw;text-align:center}

/* ---------- Print ---------- */
#printArea{display:none}
.ph{text-align:center;border-bottom:3px solid var(--navy);padding-bottom:8px;margin-bottom:12px}
.ph .co{font-size:19px;font-weight:800;color:var(--navy);letter-spacing:1px}
.ph .tag{font-size:10.5px;color:var(--teal);font-style:italic}
.ph .ad{font-size:9.5px;color:#333;margin-top:3px;line-height:1.4}
.pt{text-align:center;font-size:14px;font-weight:700;color:var(--navy);margin:10px 0 4px;letter-spacing:.6px}
.pmeta{font-size:10.5px;color:#444;margin-bottom:8px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px}
table.pgrid{width:100%;border-collapse:collapse;font-size:10.5px}
table.pgrid th{background:#0B3D56;color:#fff;border:1px solid #0B3D56;padding:5px 6px;text-align:left}
table.pgrid td{border:1px solid #9fb5bf;padding:4px 6px;vertical-align:top}
.pfoot{margin-top:14px;font-size:9.5px;color:#333;border-top:1px solid #9fb5bf;padding-top:6px}
.psign{margin-top:26px;display:flex;gap:40px;flex-wrap:wrap;font-size:10.5px}
.psign div{flex:1;min-width:180px;border-top:1px solid #333;padding-top:4px;text-align:center}
.seal{margin-top:12px;text-align:center;font-size:10px;font-weight:700;color:#0B3D56;letter-spacing:.5px}
@media print{
  body>*{display:none !important}
  #printArea{display:block !important;padding:0;margin:0}
  @page{size:A4;margin:12mm}
}
@media (max-width:640px){
  .wrap{padding:10px}
  .modal .mbody{max-height:74vh}
  .brandtext span{display:none}
}
@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}
</style>
</head>
<body>
<div class="topbar">
  <div class="brandmark">
    <div class="mono" id="logoMark"></div>
    <div class="brandtext"><b>NS FLEET</b><span>NAVI Shipping Fleet Management System</span></div>
  </div>
  <div class="spacer"></div>
  <div class="topbtns">
    <button class="tb" onclick="App.backup()">Back up data</button>
    <button class="tb" onclick="App.restore()">Restore data</button>
    <button class="tb warnbtn" id="alertBtn" onclick="App.go('dashboard')">Alerts</button>
  </div>
</div>

<nav class="modnav" id="modnav"></nav>

<div class="wrap">
  <div class="pagehead">
    <div>
      <h1 id="pgTitle">Dashboard</h1>
      <p id="pgSub">Fleet overview and action items</p>
    </div>
  </div>
  <div class="subnav" id="subnav"></div>
  <div id="view"></div>
</div>

<div class="ovl" id="ovl" onclick="if(event.target===this)UI.close()">
  <div class="modal" id="modal">
    <header><h3 id="mTitle">Title</h3><button class="x" onclick="UI.close()">&times;</button></header>
    <div class="mbody" id="mBody"></div>
    <footer id="mFoot"></footer>
  </div>
</div>

<div id="toast"></div>
<div id="printArea"></div>
<input type="file" id="hiddenFile" style="display:none">

<script>
"use strict";
/* =====================================================================
   NS FLEET — NAVI SHIPPING FLEET MANAGEMENT SYSTEM
   Single-file, offline. Data stored in this browser (localStorage).
   ===================================================================== */

/* ---------------- Storage (dual: window.storage -> localStorage) ------ */
var KEY = "NSFLEET_DB_V1";
var DB = null;

function blankDB(){
  return {
    meta:{created:new Date().toISOString(), counters:{}},
    vessels:[], dailyreports:[],
    crew:[], crewchange:[],
    components:[], pmsjobs:[], defects:[],
    requisitions:[],
    drills:[], incidents:[], audits:[], findings:[],
    certificates:[],
    voyages:[],
    bunkers:[], consumption:[], engines:[], fuellog:[]
  };
}
function load(){
  var raw=null;
  try{ raw = localStorage.getItem(KEY); }catch(e){ raw=null; }
  if(!raw){ DB = seed(blankDB()); save(); return; }
  try{
    DB = JSON.parse(raw);
    var b=blankDB();
    for(var k in b){ if(!DB[k]) DB[k]=b[k]; }
    if(!DB.meta) DB.meta=b.meta;
    if(!DB.meta.counters) DB.meta.counters={};
    migrateFuel(); migrateEngineNames(); migrateTimes();
  }catch(e){ DB = seed(blankDB()); }
}
function save(){
  try{ localStorage.setItem(KEY, JSON.stringify(DB)); }
  catch(e){ UI.toast("Storage is full. Export a backup, then remove old attachments."); }
}
/* engines encoded before the port/starboard naming are renamed in place */
function migrateEngineNames(){
  var map={"Main engine No.1":"Main engine (P)","Main engine No.2":"Main engine (S)",
           "Auxiliary engine No.1":"Auxiliary engine No.1 (P)","Auxiliary engine No.2":"Auxiliary engine No.2 (S)",
           "Auxiliary engine No.3":"Auxiliary engine No.3 (P)","Auxiliary engine No.4":"Auxiliary engine No.4 (S)"};
  (DB.engines||[]).forEach(function(e){ if(map[e.unit]) e.unit=map[e.unit]; });
  (DB.fuellog||[]).forEach(function(f){ (f.rows||[]).forEach(function(r){ if(map[r.unit]) r.unit=map[r.unit]; }); });
}

/* older flat consumption rows are carried into the per-engine log */
function migrateFuel(){
  if(!DB.consumption||!DB.consumption.length) return;
  DB.consumption.forEach(function(c){
    DB.fuellog.push({id:c.id||uid(),refNo:c.refNo||"FL-LEGACY",date:c.date,vessel:c.vessel,voyage:c.voyage||"",
      rows:[{unit:"Main engine (P)",seaHrs:c.runHours||0,portHrs:0,used:c.fuelUsed||0}],
      robEnd:c.robEnd||"",remarks:(c.remarks||"")+" (carried over from the earlier consumption log)",created:new Date().toISOString()});
  });
  DB.consumption=[];
}
/* military time: accepts 1200, 12:00, 930, 9 — returns "1200" or "" if not valid */
function hhmm(v){
  var d=String(v==null?"":v).replace(/[^0-9]/g,"");
  if(!d) return "";
  if(d.length===1||d.length===2) d=d.padStart(2,"0")+"00";
  else if(d.length===3) d="0"+d;
  else if(d.length>4) d=d.slice(0,4);
  var h=parseInt(d.slice(0,2),10), m=parseInt(d.slice(2),10);
  if(isNaN(h)||isNaN(m)||h>23||m>59) return "";
  return String(h).padStart(2,"0")+String(m).padStart(2,"0");
}
/* times stored with a colon before the change to military format */
function migrateTimes(){
  (DB.fuellog||[]).forEach(function(r){ if(r.time) r.time=hhmm(r.time); });
  (DB.bunkers||[]).forEach(function(b){ if(b.time) b.time=hhmm(b.time); });
}
function uid(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,7); }
function seq(name, prefix, pad){
  var c = DB.meta.counters; c[name] = (c[name]||0)+1;
  return prefix + String(c[name]).padStart(pad||4,"0");
}

/* ---------------- Small helpers -------------------------------------- */
function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];}); }
function today(){ var d=new Date(); return d.toISOString().slice(0,10); }
function dmy(s){ if(!s) return ""; var p=String(s).slice(0,10).split("-"); if(p.length!==3) return s; return p[2]+"/"+p[1]+"/"+p[0]; }
function days(from,to){ if(!from) return null; var a=new Date((to||today())+"T00:00:00"), b=new Date(String(from).slice(0,10)+"T00:00:00"); return Math.round((b-a)/86400000); }
function num(v){ var n=parseFloat(v); return isNaN(n)?0:n; }
function peso(v){ return "\u20B1"+num(v).toLocaleString("en-PH",{minimumFractionDigits:2,maximumFractionDigits:2}); }
function qty(v,d){ return num(v).toLocaleString("en-PH",{minimumFractionDigits:d||0,maximumFractionDigits:d||0}); }
function byId(arr,id){ for(var i=0;i<arr.length;i++){ if(arr[i].id===id) return arr[i]; } return null; }
function vesselName(id){ var v=byId(DB.vessels,id); return v?v.name:""; }
function vesselOpts(){ return DB.vessels.slice().sort(function(a,b){return (a.name||"").localeCompare(b.name||"");}).map(function(v){return {v:v.id,l:v.name};}); }
function sortBy(arr,key,desc){ return arr.slice().sort(function(a,b){ var x=a[key]||"", y=b[key]||""; if(x<y) return desc?1:-1; if(x>y) return desc?-1:1; return 0; }); }
function auditLabel(id){
  var a=byId(DB.audits,id); if(!a) return "";
  return (a.refNo||"")+" · "+(a.type||"")+" · "+dmy(a.date);
}
function auditOpts(){
  return sortBy(DB.audits||[],"date",true).map(function(a){ return {v:a.id,l:auditLabel(a.id)}; });
}
function pill(text,kind){ return '<span class="pill p-'+kind+'">'+esc(text)+'</span>'; }

/* ---------------- UI primitives (iPad-safe: no native prompt/confirm) -- */
var UI = {
  _close:null,
  open:function(title, bodyHTML, footHTML, size){
    document.getElementById("mTitle").innerHTML = title;
    document.getElementById("mBody").innerHTML = bodyHTML;
    document.getElementById("mFoot").innerHTML = footHTML||'<button class="btn g" onclick="UI.close()">Close</button>';
    var m=document.getElementById("modal"); m.className="modal"+(size?" "+size:"");
    document.getElementById("ovl").classList.add("on");
    document.getElementById("mBody").scrollTop=0;
  },
  close:function(){ document.getElementById("ovl").classList.remove("on"); if(UI._close){var f=UI._close;UI._close=null;f();} },
  toast:function(msg){
    var t=document.getElementById("toast"); t.textContent=msg; t.style.display="block";
    clearTimeout(UI._tt); UI._tt=setTimeout(function(){t.style.display="none";},2600);
  },
  alert:function(msg,title){ UI.open(esc(title||"NS FLEET"),'<div style="font-size:14px;line-height:1.5">'+msg+'</div>','<button class="btn" onclick="UI.close()">OK</button>',"sm"); },
  confirm:function(msg){
    return new Promise(function(res){
      UI.open("Please confirm",'<div style="font-size:14px;line-height:1.5">'+esc(msg)+'</div>',
        '<button class="btn g" id="cNo">Cancel</button><button class="btn d" id="cYes">Yes, continue</button>',"sm");
      document.getElementById("cNo").onclick=function(){UI.close();res(false);};
      document.getElementById("cYes").onclick=function(){UI.close();res(true);};
    });
  },
  pickFile:function(accept, cb){
    var i=document.getElementById("hiddenFile");
    i.value=""; i.accept=accept||"";
    i.onchange=function(){ if(i.files&&i.files[0]) cb(i.files[0]); };
    i.click();
  }
};

/* ---------------- Reference lists ------------------------------------ */
var VESSEL_TYPES=["Tugboat","Landing Craft Tank (LCT)","Barge","Speedboat / Motor Banca","Fast Craft","Passenger Vessel","Cargo Vessel","Dredger","Other"];
var VESSEL_STATUS=["At Sea","In Port","At Anchor","Drydock","Under Repair","Idle / Standby","Laid-up"];
var MGMT_TYPE=["Owned","Full Management","Crew Management Only","Technical Management Only","Time Chartered-in","Bareboat Chartered-in"];
var RANKS=["Master","Chief Mate","Second Mate","Third Mate","Officer in Charge Navigational Watch","Chief Engineer","Second Engineer","Third Engineer","Officer in Charge Engineering Watch","Marine Diesel Mechanic","Boat Captain","Bosun","Able Seafarer Deck","Ordinary Seaman","Motorman","Oiler","Electrician","Cook / Steward","Messman","Deck Cadet","Engine Cadet"];
var CREW_STATUS=["Onboard","On Leave","For Embarkation","Reliever Required","Separated"];
var RESPONSIBLE=["Master","Chief Mate","Chief Engineer","Second Engineer","Boat Captain","DPA / HSQE Manager","Fleet Technical Manager","Technical Superintendent","Operations Manager","President","Shore Contractor"];
var CRITICALITY=["Critical equipment","Non-critical"];
var JOB_STATUS=["Planned","Due","Overdue","In progress","Completed","Postponed (approved)"];
var DEFECT_STATUS=["Open","Under repair","Awaiting spares","Deferred (risk assessed)","Closed"];
var SEVERITY=["Minor","Major","Critical"];
var PROC_CAT=["Engine spares","Deck spares","Electrical","Lubricating oil","Safety / LSA-FFA","Provisions","Deck & engine stores","Chemicals & paints","Drydock / repair services","Third-party services"];
var PROC_STATUS=["Requested","Under review","Approved","Purchase order issued","Partially delivered","Delivered","Cancelled"];
var URGENCY=["Routine","Urgent","Vessel stopped / critical"];
var DRILL_TYPES=["Abandon ship","Fire fighting","Man overboard","Enclosed space entry and rescue","Oil spill / SOPEP","Steering gear failure","Emergency towing","Grounding / stranding","Collision","Flooding / damage control","Blackout / emergency generator","Security (ISPS) drill","Medical emergency","Helicopter / evacuation"];
