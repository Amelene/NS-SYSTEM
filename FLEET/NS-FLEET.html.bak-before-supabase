      var live = f.on? ' oninput="'+f.on+'" onchange="'+f.on+'"' : '';
      var pre=Register._presets||{};
      var val = rec? (rec[f.k]==null?"":rec[f.k]) : (pre[f.k]!==undefined? pre[f.k] : (f.def? f.def() : ""));
      var full = (f.t==="area"||f.t==="file")?" full":"";
      h+='<div class="f'+full+'"><label>'+esc(f.l)+(f.req?' <span class="req">*</span>':'')+'</label>';
      if(f.t==="select"){
        h+='<select id="fld_'+f.k+'"><option value=""></option>'+f.opts.map(function(o){return '<option'+(String(val)===o?" selected":"")+'>'+esc(o)+'</option>';}).join("")+'</select>';
      } else if(f.t==="audit"){
        h+='<select id="fld_'+f.k+'"><option value="">— select audit —</option>'+auditOpts().map(function(o){return '<option value="'+o.v+'"'+(val===o.v?" selected":"")+'>'+esc(o.l)+'</option>';}).join("")+'</select>';
      } else if(f.t==="vessel"){
        h+='<select id="fld_'+f.k+'"><option value="">— select vessel —</option>'+vesselOpts().map(function(o){return '<option value="'+o.v+'"'+(val===o.v?" selected":"")+'>'+esc(o.l)+'</option>';}).join("")+'</select>';
      } else if(f.t==="area"){
        h+='<textarea id="fld_'+f.k+'">'+esc(val)+'</textarea>';
      } else if(f.t==="ro"){
        h+='<input type="text" id="fld_'+f.k+'" value="'+esc(val)+'" readonly style="background:#eef4f7;font-weight:600">';
      } else if(f.t==="date"){
        h+='<input type="date" id="fld_'+f.k+'" value="'+esc(String(val).slice(0,10))+'"'+live+'>';
      } else if(f.t==="time"){
        h+='<input type="text" inputmode="numeric" maxlength="5" placeholder="1200" id="fld_'+f.k+'" value="'+esc(hhmm(val))+'" onblur="this.value=hhmm(this.value)'+(f.on?";"+f.on:"")+'"'+live+'>';
      } else if(f.t==="num"){
        h+='<input type="number" step="any" inputmode="decimal" id="fld_'+f.k+'" value="'+esc(val)+'"'+live+(f.focus?' onfocus="'+f.focus+'"':'')+'>';
      } else if(f.t==="file"){
        h+='<div class="filebox"><input type="hidden" id="fld_'+f.k+'" value=\''+(val?esc(JSON.stringify(val)):"")+'\'>'+
           '<button type="button" class="btn sm g" onclick="Register.attach(\''+f.k+'\')">Choose file</button>'+
           '<span id="fn_'+f.k+'">'+(val&&val.n?esc(val.n):"No file attached")+'</span>'+
           (val?' <button type="button" class="btn sm d" onclick="Register.detach(\''+f.k+'\')">Remove</button>':'')+
           '</div><div class="hint">Images or PDF up to 700 KB. Larger files will not fit in browser storage.</div>';
      } else {
        var listId="";
        if(f.list){ listId=' list="dl_'+f.k+'"'; }
        h+='<input type="text" id="fld_'+f.k+'"'+(rec&&f.ro?' readonly style="background:#f1f5f7"':'')+listId+' value="'+esc(val)+'">';
        if(f.list) h+='<datalist id="dl_'+f.k+'">'+f.list.map(function(o){return '<option value="'+esc(o)+'">';}).join("")+'</datalist>';
      }
      if(f.hint) h+='<div class="hint">'+esc(f.hint)+'</div>';
      h+='</div>';
    });
    h+='</div>';
    Register._presets=null;
