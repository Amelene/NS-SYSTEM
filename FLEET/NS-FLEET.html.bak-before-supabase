      if(open) out.push({k:"warn",t:"Audit "+(a.refNo||"")+" closed with findings still open",
        s:open+" finding"+(open===1?"":"s")+" not verified. "+(a.type||""),go:["safety","findings"]});
    });
    Audit.dueList().forEach(function(a){
      var who = a.vessel? vesselName(a.vessel) : "Office";
      var d=days(a.nextDue);
      out.push({k:(d<0?"bad":"warn"),
        t:who+" — "+a.type+(d<0? " overdue by "+Math.abs(d)+" days" : " due in "+d+" days"),
        s:"Last held "+dmy(a.date)+(a.refNo?" ("+a.refNo+")":"")+". Next due "+dmy(a.nextDue)+".",
        go:["safety","audits"]});
    });
    DrillPlan.gaps().forEach(function(g){
      out.push({k:g.overdue>15?"bad":"warn",t:g.vessel+" — "+g.drill+" drill overdue",s:g.last?("Last held "+dmy(g.last)+", "+g.overdue+" days past the monthly interval"):"No drill recorded for this vessel",go:["safety","drills"]});
    });
    FuelLog.flagged().forEach(function(r){
      var c=FuelLog.calc(r);
      var worst=c.rows.filter(function(x){return x.state==="off";})
        .map(function(x){return x.tag+" "+(x.pct>0?"+":"")+x.pct.toFixed(1)+"%";}).join(", ");
      out.push({k:"warn",t:vesselName(r.vessel)+" — fuel report out of range "+dmy(r.date),
        s:"Reported "+qty(c.used)+" L against an expected "+qty(c.expected)+" L ("+worst+"). Verify the figures with the vessel.",
        go:["fuel","variance"]});
    });
    (DB.fuellog||[]).forEach(function(r){
      var b=FuelLog.balance(r);
      if(!b.flag) return;
      out.push({k:"warn",t:vesselName(r.vessel)+" — fuel ROB does not balance "+dmy(r.date),
        s:"Sounding "+qty(b.sounded)+" L against a calculated "+qty(b.calculated)+" L (opening "+qty(b.opening)+
          " + bunkered "+qty(b.received)+" − consumed "+qty(b.consumed)+"). Difference "+(b.diff>0?"+":"")+qty(b.diff)+" L.",
        go:["fuel","fuellog"]});
    });
    (DB.requisitions||[]).forEach(function(q){
      if(q.urgency==="Vessel stopped / critical" && ["Requested","Under review","Approved"].indexOf(q.status)>=0)
        out.push({k:"bad",t:vesselName(q.vessel)+" — critical requisition awaiting supply",s:(q.reqNo||"")+": "+String(q.item||"").slice(0,80),go:["procurement","requisitions"]});
    });
    var rank={bad:0,warn:1,info:2};
    return out.sort(function(a,b){return rank[a.k]-rank[b.k];});
  }
};

/* ---------------- Drill compliance (monthly interval) ----------------- */
var DrillPlan={
  mandatory:["Abandon ship","Fire fighting"],
  lastFor:function(vId,drill){
    var recs=(DB.drills||[]).filter(function(d){return d.vessel===vId&&d.drill===drill&&d.date;});
    if(!recs.length) return null;
    return sortBy(recs,"date",true)[0].date;
  },
  gaps:function(){
    var out=[], started=(DB.drills||[]).length>0;
    if(!started) return out;
    (DB.vessels||[]).forEach(function(v){
      if(v.status==="Laid-up") return;
      DrillPlan.mandatory.forEach(function(d){
        var last=DrillPlan.lastFor(v.id,d);
        var over = last? -days(last)-31 : null;
        if(!last) out.push({vessel:v.name,drill:d,last:null,overdue:999});
        else if(over>0) out.push({vessel:v.name,drill:d,last:last,overdue:over});
      });
    });
    return out;
  }
};

