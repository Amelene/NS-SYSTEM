var App={
  mod:"dashboard", tab:null, filter:{q:"",vessel:""},

  start:function(){
    load();
    document.getElementById("logoMark").innerHTML=logoSVG();
    setFavicon();
    var nav=document.getElementById("modnav");
    nav.innerHTML=MODULES.map(function(m){return '<button data-m="'+m.id+'" onclick="App.go(\''+m.id+'\')">'+esc(m.label)+'</button>';}).join("");
    App.go("dashboard");
  },

  go:function(mod,tab){
    App.mod=mod;
    var m=App.module();
    App.tab = tab || (m.tabs? m.tabs[0].id : null);
    App.filter={q:"",vessel:""};
    document.getElementById("pgTitle").textContent=m.title;
    document.getElementById("pgSub").textContent=m.sub;
    var btns=document.querySelectorAll("#modnav button");
    for(var i=0;i<btns.length;i++){ btns[i].className = btns[i].getAttribute("data-m")===mod?"on":""; }
    var sn=document.getElementById("subnav");
    sn.innerHTML = m.tabs? m.tabs.map(function(t){return '<button class="'+(t.id===App.tab?"on":"")+'" onclick="App.go(\''+mod+'\',\''+t.id+'\')">'+esc(t.l)+'</button>';}).join("") : "";
    window.scrollTo(0,0);
    App.render();
  },

  module:function(){ for(var i=0;i<MODULES.length;i++){ if(MODULES[i].id===App.mod) return MODULES[i]; } return MODULES[0]; },

  render:function(){
    var v=document.getElementById("view");
    if(App.mod==="dashboard") return void(v.innerHTML=Views.dashboard());
    if(App.mod==="reports")   return void(v.innerHTML=Views.reports());
    if(App.tab==="fuellog")   return void(v.innerHTML=FuelLog.view());
    if(App.tab==="variance")  return void(v.innerHTML=FuelLog.varianceView());
    if(SCHEMAS[App.tab])      return void(v.innerHTML=Register.view(App.tab));
    if(Views[App.tab])        return void(v.innerHTML=Views[App.tab]());
    v.innerHTML='<div class="card"><div class="empty">Nothing to show here yet.</div></div>';
    App.refreshAlertBadge();
  },

  refreshAlertBadge:function(){
    var n=Alerts.all().length, b=document.getElementById("alertBtn");
    b.textContent = n? ("Alerts ("+n+")") : "Alerts";
    b.className = "tb"+(n?" warnbtn":"");
  },

  backup:function(){
    var blob=new Blob([JSON.stringify(DB,null,2)],{type:"application/json"});
    var url=URL.createObjectURL(blob), a=document.createElement("a");
    a.href=url; a.download="NS-FLEET-backup-"+today()+".json"; document.body.appendChild(a); a.click();
    setTimeout(function(){URL.revokeObjectURL(url);a.remove();},1500);
    UI.open("Back up data",
      '<p>A file named <b>NS-FLEET-backup-'+today()+'.json</b> has been prepared.</p>'+
      '<p style="font-size:13px;color:#5d7480">On iPad, if nothing downloaded, use the button below and choose <b>Save to Files</b> from the share sheet.</p>'+
      '<p><a class="btn" style="text-decoration:none;display:inline-block" href="'+url+'" download="NS-FLEET-backup-'+today()+'.json">Save backup file</a></p>',
      '<button class="btn g" onclick="UI.close()">Done</button>',"sm");
  },

  restore:function(){
    UI.pickFile(".json,application/json",function(file){
      var r=new FileReader();
      r.onload=function(){
        try{
          var d=JSON.parse(r.result);
          if(!d.vessels&&!d.crew) throw new Error("not NS FLEET");
          UI.confirm("Restoring replaces everything currently stored in this browser. Continue?").then(function(ok){
            if(!ok) return;
            var b=blankDB(); for(var k in b){ if(!d[k]) d[k]=b[k]; }
            if(!d.meta) d.meta=b.meta; if(!d.meta.counters) d.meta.counters={};
            DB=d; save(); App.go(App.mod); UI.toast("Data restored");
          });
        }catch(e){ UI.alert("That file could not be read as an NS FLEET backup. Choose the .json file created by <b>Back up data</b>."); }
      };
      r.readAsText(file);
    });
  }
};

/* ---------------- Generic register engine ---------------------------- */
var Register={

  rows:function(key){
    var s=SCHEMAS[key], data=DB[key]||[];
    var q=(App.filter.q||"").toLowerCase(), vf=App.filter.vessel;
    var out=data.filter(function(r){
      if(vf && r.vessel!==vf) return false;
      if(!q) return true;
      var hay="";
      for(var k in r){ var val=r[k]; if(typeof val==="string"||typeof val==="number") hay+=" "+val; }
      hay+=" "+vesselName(r.vessel);
      return hay.toLowerCase().indexOf(q)>=0;
    });
    return sortBy(out, s.sort||"id", !!s.sortDesc);
  },

  hasVessel:function(key){ return SCHEMAS[key].fields.some(function(f){return f.k==="vessel";}); },

  view:function(key){
    var s=SCHEMAS[key], rows=Register.rows(key);
    var cols=s.fields.filter(function(f){return f.col;});
    var h='<div class="card">';
    h+='<h2>'+esc(s.title)+'<span class="r">'+
        '<button class="btn sm o" onclick="Register.form(\''+key+'\')">Add '+esc(s.singular)+'</button>'+
        '<button class="btn sm g" onclick="Register.csv(\''+key+'\')">Export CSV</button>'+
        '<button class="btn sm g" onclick="Register.print(\''+key+'\')">Print</button>'+
        (key==="crew"?'<button class="btn sm g" onclick="Register.importCrew()">Import crew file</button>':'')+
       '</span></h2>';
    h+='<div class="toolbar">';
    h+='<input type="text" class="grow" placeholder="Search '+esc(s.title.toLowerCase())+'" value="'+esc(App.filter.q)+'" oninput="App.filter.q=this.value;Register.refresh(\''+key+'\')">';
    if(Register.hasVessel(key)){
      h+='<select onchange="App.filter.vessel=this.value;Register.refresh(\''+key+'\')"><option value="">All vessels</option>'+
         vesselOpts().map(function(o){return '<option value="'+o.v+'"'+(App.filter.vessel===o.v?" selected":"")+'>'+esc(o.l)+'</option>';}).join("")+'</select>';
    }
    h+='<span style="color:#5d7480;font-size:12.5px" id="cnt-'+key+'">'+rows.length+' record'+(rows.length===1?"":"s")+'</span>';
    h+='</div><div class="body tight" id="tbl-'+key+'">'+Register.table(key,rows,cols)+'</div></div>';
    h+='<p style="font-size:12px;color:#5d7480;margin:0 2px 20px">'+esc(s.sub)+'</p>';
    setTimeout(App.refreshAlertBadge,0);
    return h;
  },

  refresh:function(key){
    var rows=Register.rows(key), cols=SCHEMAS[key].fields.filter(function(f){return f.col;});
    document.getElementById("tbl-"+key).innerHTML=Register.table(key,rows,cols);
    document.getElementById("cnt-"+key).textContent=rows.length+" record"+(rows.length===1?"":"s");
  },

  cell:function(f,r){
    var v=r[f.k];
    if(f.t==="calc") return f.fn(r);
    if(f.t==="vessel") return esc(vesselName(v));
    if(f.t==="audit") return esc(auditLabel(v));
    if(f.t==="file") return v? '<a href="#" onclick="Register.viewFile(\''+esc(f.k)+'\',\''+r.id+'\',\''+App.tab+'\');return false;">View</a>' : '<span style="color:#9db3bd">—</span>';
    if(f.t==="date") return esc(dmy(v));
    if(f.t==="time") return esc(hhmm(v));
    if(f.t==="ro") return esc(v||"");
    if(f.t==="num"){ if(v===""||v==null) return ""; return esc(qty(v, String(v).indexOf(".")>=0?2:0)); }
    if(f.t==="area"){ var t=String(v||""); return esc(t.length>70?t.slice(0,70)+"…":t); }
    if(f.k==="status"||f.k==="state") return Register.statusCell(v);
    return esc(v);
  },

  statusCell:function(v){
    if(!v) return "";
    var bad=["Overdue","Open","Expired","Cancelled","Reported","Vessel stopped / critical"];
    var warn=["Due","Under repair","Awaiting spares","Under review","Under investigation","Requested","Findings issued","Deferred (risk assessed)","Corrective action in progress","Reliever Required","Drydock","Under Repair"];
    var ok=["Completed","Closed","Delivered","Onboard","At Sea","In Port","Approved","Valid"];
    var kind = bad.indexOf(v)>=0?"bad" : warn.indexOf(v)>=0?"warn" : ok.indexOf(v)>=0?"ok" : "info";
    return pill(v,kind);
  },

  table:function(key,rows,cols){
    if(!rows.length) return '<div class="empty"><b>Nothing recorded yet</b>Use "Add '+esc(SCHEMAS[key].singular)+'" to create the first entry.</div>';
    var h='<div class="tw"><table class="grid"><thead><tr>';
    cols.forEach(function(f){ h+='<th>'+esc(f.l)+'</th>'; });
    h+='<th>Actions</th></tr></thead><tbody>';
    rows.forEach(function(r){
      h+='<tr>';
      cols.forEach(function(f){ h+='<td>'+Register.cell(f,r)+'</td>'; });
      h+='<td class="act">'+
         '<button class="btn sm g" onclick="Register.detail(\''+key+'\',\''+r.id+'\')">Open</button> '+
         '<button class="btn sm" onclick="Register.form(\''+key+'\',\''+r.id+'\')">Edit</button> '+
         '<button class="btn sm d" onclick="Register.del(\''+key+'\',\''+r.id+'\')">Delete</button></td></tr>';
    });
    return h+'</tbody></table></div>';
  },

  /* ---- form ---- */
  form:function(key,id){
    var s=SCHEMAS[key], rec = id? byId(DB[key],id) : null;
    if(key!=="vessels" && Register.hasVessel(key) && !DB.vessels.length && !rec){
      return UI.alert("Add a vessel first. Every record in NS FLEET is filed against a vessel, so the vessel register has to be populated before anything else.","No vessels yet");
