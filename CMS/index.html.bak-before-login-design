<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NAVI Crewing Portal (Live)</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script src="config.js"></script>
<style>
  :root{ --navy:#0F3B45; --teal:#146B78; --orange:#E8734A; --cream:#F6F4EF; --ink:#1D2A2E; --slate:#5C6B6F; --line:#E5E0D3; }
  *{box-sizing:border-box;}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:var(--cream);color:var(--ink);}
  header{background:var(--navy);color:#fff;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
  header h1{font-size:18px;margin:0;font-weight:700;}
  .tabs{display:flex;gap:6px;padding:10px 14px;background:#fff;border-bottom:1px solid var(--line);flex-wrap:wrap;}
  .tab-btn{padding:8px 14px;border-radius:8px;border:1px solid var(--line);background:#fff;cursor:pointer;font-size:13.5px;font-weight:600;color:var(--slate);}
  .tab-btn.active{background:var(--teal);color:#fff;border-color:var(--teal);}
  .tab-btn:disabled{opacity:.45;cursor:not-allowed;}
  main{padding:16px;max-width:1100px;margin:0 auto;}
  .card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:14px;}
  table{width:100%;border-collapse:collapse;font-size:13.5px;}
  th,td{padding:8px 10px;text-align:left;border-bottom:1px solid var(--line);}
  th{background:var(--cream);font-weight:700;color:var(--navy);}
  .btn{background:var(--teal);color:#fff;border:none;padding:9px 16px;border-radius:8px;font-weight:700;cursor:pointer;font-size:13.5px;}
  .btn.secondary{background:#fff;color:var(--teal);border:1px solid var(--teal);}
  .btn.danger{background:#B23A34;}
  .field{display:flex;flex-direction:column;gap:4px;margin-bottom:10px;}
  .field label{font-size:12px;font-weight:700;color:var(--slate);}
  .field input,.field select,.field textarea{padding:8px 10px;border:1px solid var(--line);border-radius:8px;font-size:14px;}
  .field-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;}
  .login-wrap{max-width:380px;margin:80px auto;padding:24px;}
  .badge{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11.5px;font-weight:700;}
  .badge.online{background:#DCF3E6;color:#146B4C;}
  .live-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#39D97A;margin-right:6px;animation:pulse 1.6s infinite;}
  @keyframes pulse{0%{opacity:1;}50%{opacity:.35;}100%{opacity:1;}}
  .err{color:#B23A34;font-size:13px;margin-top:8px;}
  .muted{color:var(--slate);font-size:12.5px;}
</style>
</head>
<body>
<div id="app">Loading… (build check: v2)</div>

<script>
function esc(s){ if(s==null) return ""; return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
function showFatal(title, detail){
  document.getElementById("app").innerHTML = `<div class="login-wrap card">
    <h2 style="color:#B23A34;">${esc(title)}</h2>
    <pre style="white-space:pre-wrap;font-size:12.5px;background:#F6F4EF;padding:10px;border-radius:8px;color:#8a2f2a;">${esc(detail)}</pre>
    <p class="muted">Take a screenshot of this exact screen and send it over — it tells us exactly what to fix.</p>
  </div>`;
}

if(typeof SUPABASE_URL === "undefined" || typeof SUPABASE_ANON_KEY === "undefined"){
  showFatal("config.js did not load", "The file config.js is missing from this deployment, or has a typo that stopped it from running. Check that config.js was included in the folder you dragged to Netlify, sitting right next to index.html.");
  throw new Error("config.js not loaded");
}
if(!SUPABASE_URL || SUPABASE_URL.indexOf("PASTE_") === 0){
  showFatal("Setup needed", "Open config.js and paste in your Supabase Project URL and anon key (Supabase Dashboard → Project Settings → API), then re-deploy to Netlify.");
  throw new Error("Supabase not configured yet");
}
if(typeof window.supabase === "undefined"){
  showFatal("Could not load the Supabase library", "This page tried to load a script from cdn.jsdelivr.net and it didn't arrive — check your internet connection and reload. If this keeps happening, your network or an ad-blocker may be blocking it.");
  throw new Error("supabase-js failed to load");
}

const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

let session = null;
let profile = null;
let vessels = [];
let crew = [];
let activeTab = "dashboard";
let channelsSubscribed = false;

function calcAge(dob){ if(!dob) return null; const d=new Date(dob), n=new Date(); let a=n.getFullYear()-d.getFullYear(); const m=n.getMonth()-d.getMonth(); if(m<0||(m===0&&n.getDate()<d.getDate())) a--; return a; }

/* ---------------- AUTH ---------------- */
async function renderLogin(err){
  document.getElementById("app").innerHTML = `
    <div class="login-wrap card">
      <h2 style="margin-top:0;color:var(--navy);">NAVI Crewing Portal</h2>
      <p class="muted">Sign in with the account your admin created for you.</p>
      <div class="field"><label>Email</label><input id="loginEmail" type="email" autocomplete="username"></div>
      <div class="field"><label>Password</label><input id="loginPass" type="password" autocomplete="current-password"></div>
      <button class="btn" style="width:100%;" onclick="doLogin()">Sign In</button>
      ${err ? `<div class="err">${esc(err)}</div>` : ""}
    </div>`;
}
async function doLogin(){
  const email = document.getElementById("loginEmail").value.trim();
  const password = document.getElementById("loginPass").value;
  const { error } = await db.auth.signInWithPassword({ email, password });
  if(error){ renderLogin(error.message); return; }
  await boot();
}
async function doLogout(){
  channelsSubscribed = false;
  await db.auth.signOut();
  session = null; profile = null; vessels = []; crew = [];
  renderLogin();
}

/* ---------------- DATA LOAD + REALTIME ---------------- */
async function loadAll(){
  const { data: v } = await db.from("vessels").select("*").order("name");
  vessels = v || [];
  const { data: c } = await db.from("crew").select("*, vessels(id,name)").order("crew_name");
  crew = c || [];
}
function subscribeRealtime(){
  if(channelsSubscribed) return;
  channelsSubscribed = true;
  db.channel("crew-live")
    .on("postgres_changes", { event: "*", schema: "public", table: "crew" }, async () => { await loadAll(); render(); })
    .subscribe();
  db.channel("vessels-live")
    .on("postgres_changes", { event: "*", schema: "public", table: "vessels" }, async () => { await loadAll(); render(); })
    .subscribe();
}

async function boot(){
  const { data: sessData, error: sessErr } = await db.auth.getSession();
  if(sessErr){ throw new Error("Could not reach Supabase Auth: " + sessErr.message); }
  const s = sessData.session;
  if(!s){ renderLogin(); return; }
  // Signed in: hand off to the full Crewing Management System view.
  location.replace("navi-crewing-system-standalone.html");
  return;
  session = s;
  const { data: p, error: profErr } = await db.from("profiles").select("*").eq("id", s.user.id).single();
  if(profErr){ console.warn("Could not load profile row (continuing anyway):", profErr.message); }
  profile = p || null;
  await loadAll();
  subscribeRealtime();
  render();
}

db.auth.onAuthStateChange((event, s) => {
  if(event === "SIGNED_OUT"){ session = null; renderLogin(); }
});

/* ---------------- SHELL / RENDER ---------------- */
function setTab(t){ activeTab = t; render(); }

function render(){
  if(!session){ renderLogin(); return; }
  const app = document.getElementById("app");
  app.innerHTML = `
    <header>
      <h1>⚓ NAVI Crewing Portal</h1>
      <div style="display:flex;align-items:center;gap:14px;">
        <span class="badge online"><span class="live-dot"></span>Live</span>
        <span style="font-size:13px;">${esc(profile?.full_name || session.user.email)}</span>
        <button class="btn secondary" onclick="doLogout()">Sign out</button>
      </div>
    </header>
    <div class="tabs">
      <button class="tab-btn ${activeTab==='dashboard'?'active':''}" onclick="setTab('dashboard')">📊 Dashboard</button>
      <button class="tab-btn ${activeTab==='crew'?'active':''}" onclick="setTab('crew')">👥 Crew Roster</button>
      <button class="tab-btn ${activeTab==='vessels'?'active':''}" onclick="setTab('vessels')">🚢 Vessels</button>
      <button class="tab-btn" disabled title="Coming in the next update">📄 Documents (soon)</button>
      <button class="tab-btn" disabled title="Coming in the next update">📋 CRP 09 (soon)</button>
    </div>
    <main id="main"></main>
  `;
  if(activeTab==="dashboard") renderDashboard();
  else if(activeTab==="crew") renderCrew();
  else if(activeTab==="vessels") renderVessels();
}

/* ---------------- DASHBOARD ---------------- */
function renderDashboard(){
  const onboard = crew.filter(c=>c.status==="Onboard").length;
  const standby = crew.filter(c=>c.status==="Standby/Pooling").length;
  document.getElementById("main").innerHTML = `
    <div class="field-grid">
      <div class="card"><div class="muted">Total Crew Records</div><div style="font-size:28px;font-weight:800;color:var(--navy);">${crew.length}</div></div>
      <div class="card"><div class="muted">Onboard</div><div style="font-size:28px;font-weight:800;color:#146B4C;">${onboard}</div></div>
      <div class="card"><div class="muted">Standby / Pooling</div><div style="font-size:28px;font-weight:800;color:var(--orange);">${standby}</div></div>
      <div class="card"><div class="muted">Vessels</div><div style="font-size:28px;font-weight:800;color:var(--navy);">${vessels.length}</div></div>
    </div>
    <div class="card muted">Every screen on this portal updates instantly for all signed-in staff — no refresh needed. Try opening this in two browser tabs and editing a crew record in one.</div>
  `;
}

/* ---------------- VESSELS ---------------- */
function renderVessels(){
  document.getElementById("main").innerHTML = `
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <h3 style="margin:0;">Vessels</h3>
        <button class="btn" onclick="showVesselForm()">+ Add Vessel</button>
      </div>
      <table>
        <thead><tr><th>Name</th><th>Type</th><th>Home Port</th><th>MARINA Reg No.</th><th>GRT</th><th></th></tr></thead>
        <tbody>
          ${vessels.map(v=>`<tr>
            <td>${esc(v.name)}</td><td>${esc(v.vessel_type)||'—'}</td><td>${esc(v.home_port)||'—'}</td>
            <td>${esc(v.marina_reg_no)||'—'}</td><td>${v.grt||'—'}</td>
            <td><button class="btn secondary" onclick="showVesselForm('${v.id}')">Edit</button></td>
          </tr>`).join("") || `<tr><td colspan="6" class="muted">No vessels yet.</td></tr>`}
        </tbody>
      </table>
    </div>
    <div id="vesselFormHost"></div>
  `;
}
function showVesselForm(id){
  const v = id ? vessels.find(x=>x.id===id) : null;
  document.getElementById("vesselFormHost").innerHTML = `
    <div class="card">
      <h3 style="margin-top:0;">${v?"Edit":"Add"} Vessel</h3>
      <div class="field-grid">
        <div class="field"><label>Name *</label><input id="vf_name" value="${esc(v?.name)}"></div>
        <div class="field"><label>Type</label><input id="vf_type" value="${esc(v?.vessel_type)}"></div>
        <div class="field"><label>Home Port</label><input id="vf_home" value="${esc(v?.home_port)}"></div>
        <div class="field"><label>MARINA Reg No.</label><input id="vf_reg" value="${esc(v?.marina_reg_no)}"></div>
        <div class="field"><label>GRT</label><input id="vf_grt" type="number" value="${v?.grt??''}"></div>
        <div class="field"><label>Engine Power (kW)</label><input id="vf_kw" type="number" value="${v?.engine_power_kw??''}"></div>
      </div>
      <button class="btn" onclick="saveVessel(${v?`'${v.id}'`:'null'})">Save</button>
      <button class="btn secondary" onclick="document.getElementById('vesselFormHost').innerHTML=''">Cancel</button>
      ${v?`<button class="btn danger" style="float:right;" onclick="deleteVessel('${v.id}')">Delete</button>`:""}
    </div>`;
}
async function saveVessel(id){
  const payload = {
    name: document.getElementById("vf_name").value.trim(),
    vessel_type: document.getElementById("vf_type").value.trim(),
    home_port: document.getElementById("vf_home").value.trim(),
    marina_reg_no: document.getElementById("vf_reg").value.trim(),
    grt: parseFloat(document.getElementById("vf_grt").value)||null,
    engine_power_kw: parseFloat(document.getElementById("vf_kw").value)||null,
    updated_at: new Date().toISOString(),
    updated_by: session.user.id,
  };
  if(!payload.name){ alert("Vessel name is required."); return; }
  if(id) await db.from("vessels").update(payload).eq("id", id);
  else await db.from("vessels").insert([payload]);
  // No manual refresh needed — realtime subscription will update the UI for everyone, including this tab.
}
async function deleteVessel(id){
  if(!confirm("Delete this vessel? Crew assigned to it will need reassigning.")) return;
  await db.from("vessels").delete().eq("id", id);
}

/* ---------------- CREW ---------------- */
const POSITIONS = ["MASTER","CHIEF MATE","OIC-NW","AB","OS","CHIEF ENGINEER","2ND ENGINEER","OILER","MOTORMAN","COOK","STEWARD","DECK CADET","ENGINE CADET","BOAT CAPTAIN"];
const STATUSES = ["Onboard","Vacant","Standby/Pooling","Not for Rehire (NFR)","Health & Safety","Lined-up","Ongoing Recruitment Process","For Embarkation","For Disembarkation","For Transfer to Other Vessel","Medical Repatriation","Medication","Training","For Promotion","Pending Case"];

function renderCrew(){
  document.getElementById("main").innerHTML = `
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
        <h3 style="margin:0;">Crew Roster</h3>
        <button class="btn" onclick="showCrewForm()">+ Add Crew</button>
      </div>
      <table>
        <thead><tr><th>CCN</th><th>Name</th><th>Position</th><th>Vessel</th><th>Status</th><th></th></tr></thead>
        <tbody>
          ${crew.map(c=>`<tr>
            <td>${esc(c.crew_control_no)||'—'}</td>
            <td>${esc(c.crew_name)}</td>
            <td>${esc(c.position)||'—'}</td>
            <td>${esc(c.vessels?.name)||'—'}</td>
            <td>${esc(c.status)||'—'}</td>
            <td><button class="btn secondary" onclick="showCrewForm('${c.id}')">Edit</button></td>
          </tr>`).join("") || `<tr><td colspan="6" class="muted">No crew records yet.</td></tr>`}
        </tbody>
      </table>
    </div>
    <div id="crewFormHost"></div>
  `;
}
function showCrewForm(id){
  const c = id ? crew.find(x=>x.id===id) : null;
  document.getElementById("crewFormHost").innerHTML = `
    <div class="card">
      <h3 style="margin-top:0;">${c?"Edit":"Add"} Crew</h3>
      <div class="field-grid">
        <div class="field"><label>Crew Control No.</label><input id="cf_ccn" value="${esc(c?.crew_control_no)}"></div>
        <div class="field"><label>Name *</label><input id="cf_name" value="${esc(c?.crew_name)}" placeholder="Last, First Middle"></div>
        <div class="field"><label>Vessel</label>
          <select id="cf_vessel"><option value="">— none —</option>
            ${vessels.map(v=>`<option value="${v.id}" ${c?.vessel_id===v.id?'selected':''}>${esc(v.name)}</option>`).join("")}
          </select>
        </div>
        <div class="field"><label>Position</label>
          <select id="cf_position"><option value="">— select —</option>
            ${POSITIONS.map(p=>`<option ${c?.position===p?'selected':''}>${p}</option>`).join("")}
          </select>
        </div>
        <div class="field"><label>Status</label>
          <select id="cf_status"><option value="">— select —</option>
            ${STATUSES.map(s=>`<option ${c?.status===s?'selected':''}>${s}</option>`).join("")}
          </select>
        </div>
        <div class="field"><label>Nationality</label><input id="cf_nat" value="${esc(c?.nationality)}"></div>
        <div class="field"><label>Contact No.</label><input id="cf_contact" value="${esc(c?.contact_no)}"></div>
        <div class="field"><label>SIRB No.</label><input id="cf_sirb" value="${esc(c?.sirb_no)}"></div>
        <div class="field"><label>SIRB Expiry</label><input id="cf_sirbexp" type="date" value="${c?.sirb_expiry||''}"></div>
        <div class="field"><label>Date of Birth</label><input id="cf_dob" type="date" value="${c?.dob||''}"></div>
        <div class="field"><label>Remarks</label><input id="cf_remarks" value="${esc(c?.remarks)}"></div>
      </div>
      <button class="btn" onclick="saveCrew(${c?`'${c.id}'`:'null'})">Save</button>
      <button class="btn secondary" onclick="document.getElementById('crewFormHost').innerHTML=''">Cancel</button>
      ${c?`<button class="btn danger" style="float:right;" onclick="deleteCrew('${c.id}')">Delete</button>`:""}
    </div>`;
}
async function saveCrew(id){
  const name = document.getElementById("cf_name").value.trim();
  if(!name){ alert("Crew name is required."); return; }
  const payload = {
    crew_control_no: document.getElementById("cf_ccn").value.trim() || null,
    crew_name: name,
    vessel_id: document.getElementById("cf_vessel").value || null,
    position: document.getElementById("cf_position").value || null,
    status: document.getElementById("cf_status").value || null,
    nationality: document.getElementById("cf_nat").value.trim() || null,
    contact_no: document.getElementById("cf_contact").value.trim() || null,
    sirb_no: document.getElementById("cf_sirb").value.trim() || null,
    sirb_expiry: document.getElementById("cf_sirbexp").value || null,
    dob: document.getElementById("cf_dob").value || null,
    remarks: document.getElementById("cf_remarks").value.trim() || null,
    updated_at: new Date().toISOString(),
    updated_by: session.user.id,
  };
  if(id) await db.from("crew").update(payload).eq("id", id);
  else await db.from("crew").insert([payload]);
}
async function deleteCrew(id){
  if(!confirm("Delete this crew record?")) return;
  await db.from("crew").delete().eq("id", id);
}

/* ---------------- INIT ---------------- */
boot().catch(err => {
  showFatal("Could not connect to the live database", (err && err.message) ? err.message : String(err));
});
</script>
</body>
</html>
